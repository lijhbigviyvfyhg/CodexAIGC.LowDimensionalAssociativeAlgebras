import CodexAIGC.Classification.DimensionThreeRealComplexUnitalNonstraightReduction

/-!
# Algebraic reduction for the waved sector in dimension three

This file develops the part of the waved-sector classification that is common
to both `ℂ` and `ℝ`.  Starting from the intrinsic definition (neither curled
nor straight), we choose an element `f` for which `f,f²` are independent,
extend them to a basis, and prove that non-straightness forces the cubic
relation

`f³ = a f + b f²`.

Associativity then determines the whole multiplication on the two-dimensional
subalgebra generated by `f`.  No literature normal form is assumed here.
-/

namespace CodexAIGC.DimensionThreeRealComplex

open StructureConstants

universe u

variable {K : Type u} [Field K]

/-- Bilinearity for two unrelated sums. -/
theorem mul_add_add_three (c : StructureConstants K 3)
    (x y z w : V K) :
    c.mul (x + y) (z + w) =
      c.mul x z + c.mul x w + c.mul y z + c.mul y w := by
  apply funext_three <;> simp [mul, Fin.sum_univ_three] <;> ring

/-- Failure of curledness supplies an element independent from its square. -/
theorem exists_pairIndependent_square_of_not_isCurled
    {c : StructureConstants K 3} (hc : ¬ IsCurled c) :
    ∃ f : V K, PairIndependent f (c.mul f f) := by
  change ¬ ∀ x, ∃ a : K, c.mul x x = a • x at hc
  push Not at hc
  obtain ⟨f, hf⟩ := hc
  refine ⟨f, ?_⟩
  constructor
  · intro hf0
    apply hf 0
    subst f
    simp [← mulLinear_apply]
  · intro a ha
    exact hf a ha

/-- An independent pair in `K³` can be completed to an independent triple.

The proof uses an arbitrary completion of the first nonzero vector and then
replaces one of the two complementary vectors.  This keeps the statement in
the concrete coordinate space used throughout the classification.
-/
theorem exists_third_of_pairIndependent {x y : V K}
    (hxy : PairIndependent x y) :
    ∃ z : V K, TripleIndependent x y z := by
  obtain ⟨p, q, hpq⟩ := exists_tripleIndependent_of_ne_zero x hxy.1
  let E := basisEquivOfTripleIndependent hpq
  let r := E.symm y
  have hy : y = r 0 • x + r 1 • p + r 2 • q := by
    calc
      y = E (E.symm y) := (E.apply_symm_apply y).symm
      _ = _ := basisEquivOfTripleIndependent_apply hpq r
  by_cases hr2 : r 2 = 0
  · have hr1 : r 1 ≠ 0 := by
      intro hr1
      apply hxy.2 (r 0)
      simpa [hr1, hr2] using hy
    have hqpy : TripleIndependent x q y := by
      have hxpq : TripleIndependent x q p := tripleIndependent_swap_last hpq
      rw [hy]
      simpa [add_comm, add_left_comm, add_assoc] using
        tripleIndependent_replace_third hxpq (r 0) (r 2) (r 1) hr1
    exact ⟨q, tripleIndependent_swap_last hqpy⟩
  · have hpy : TripleIndependent x p y := by
      rw [hy]
      exact tripleIndependent_replace_third hpq (r 0) (r 1) (r 2) hr2
    exact ⟨p, tripleIndependent_swap_last hpy⟩

/-- An invertible change in the first two vectors of a basis preserves triple
independence. -/
theorem tripleIndependent_plane_change
    {x y z : V K} (h : TripleIndependent x y z)
    (alpha beta gamma delta : K)
    (hdet : alpha * delta - beta * gamma ≠ 0) :
    TripleIndependent (alpha • x + beta • y)
      (gamma • x + delta • y) z := by
  rw [TripleIndependent, Fintype.linearIndependent_iff] at h ⊢
  intro q hrel
  have hrel' :
      q 0 • (alpha • x + beta • y) +
          q 1 • (gamma • x + delta • y) + q 2 • z = 0 := by
    simpa [Fin.sum_univ_three] using hrel
  let r : Fin 3 → K :=
    at3 (q 0 * alpha + q 1 * gamma)
      (q 0 * beta + q 1 * delta) (q 2)
  have hrrel : ∑ i, r i • at3 x y z i = 0 := by
    simp [r, Fin.sum_univ_three]
    calc
      (q 0 * alpha + q 1 * gamma) • x +
            (q 0 * beta + q 1 * delta) • y + q 2 • z =
          q 0 • (alpha • x + beta • y) +
            q 1 • (gamma • x + delta • y) + q 2 • z := by
        apply funext_three <;> simp [smul_add, smul_smul] <;> ring
      _ = 0 := hrel'
  have hr0 := h r hrrel 0
  have hr1 := h r hrrel 1
  have hq2 : q 2 = 0 := by simpa [r] using h r hrrel 2
  have hq0det : q 0 * (alpha * delta - beta * gamma) = 0 := by
    dsimp [r] at hr0 hr1
    linear_combination delta * hr0 - gamma * hr1
  have hq0 : q 0 = 0 := (mul_eq_zero.mp hq0det).resolve_right hdet
  have hq1det : q 1 * (alpha * delta - beta * gamma) = 0 := by
    dsimp [r] at hr0 hr1
    linear_combination alpha * hr1 - beta * hr0
  have hq1 : q 1 = 0 := (mul_eq_zero.mp hq1det).resolve_right hdet
  intro i
  fin_cases i
  · exact hq0
  · exact hq1
  · exact hq2

/-- Adding a linear combination of the other two basis vectors to the first
one preserves independence. -/
theorem tripleIndependent_add_span_to_first
    {x y z : V K} (h : TripleIndependent x y z) (a b : K) :
    TripleIndependent (x + (a • y + b • z)) y z := by
  have hcycle : TripleIndependent y z x := tripleIndependent_cycle h
  have hreplace := tripleIndependent_replace_third hcycle a b 1 one_ne_zero
  have hback := tripleIndependent_cycle (tripleIndependent_cycle hreplace)
  simpa [add_comm, add_left_comm, add_assoc] using hback

/-- Every ambient vector has unique coordinates in an independent triple. -/
theorem exists_three_coefficients {x y z : V K} (w : V K)
    (h : TripleIndependent x y z) :
    ∃ a b d : K, w = a • x + b • y + d • z := by
  let E := basisEquivOfTripleIndependent h
  let q := E.symm w
  refine ⟨q 0, q 1, q 2, ?_⟩
  calc
    w = E (E.symm w) := (E.apply_symm_apply w).symm
    _ = _ := basisEquivOfTripleIndependent_apply h q

/-- It is enough to verify a two-sided identity on an independent triple. -/
theorem hasTwoSidedIdentity_of_basis
    {c : StructureConstants K 3} {one x y z : V K}
    (hlin : TripleIndependent x y z)
    (hx : c.mul one x = x ∧ c.mul x one = x)
    (hy : c.mul one y = y ∧ c.mul y one = y)
    (hz : c.mul one z = z ∧ c.mul z one = z) :
    HasTwoSidedIdentity c := by
  refine ⟨one, ?_⟩
  intro w
  obtain ⟨a, b, d, rfl⟩ := exists_three_coefficients w hlin
  constructor
  · rw [mul_second_linearCombination_three, hx.1, hy.1, hz.1]
  · rw [mul_first_linearCombination_three, hx.2, hy.2, hz.2]

/-- A triangular change used to detect straightness in a direct sum of a
nilpotent chain and an idempotent line. -/
theorem tripleIndependent_nil_add_idempotent
    {e n h : V K} (hlin : TripleIndependent e n h) :
    TripleIndependent (n + h) (e + h) h := by
  rw [TripleIndependent, Fintype.linearIndependent_iff] at hlin ⊢
  intro q hrel
  have hrel' : q 0 • (n + h) + q 1 • (e + h) + q 2 • h = 0 := by
    simpa [Fin.sum_univ_three] using hrel
  let r : Fin 3 → K := at3 (q 1) (q 0) (q 0 + q 1 + q 2)
  have hrrel : ∑ i, r i • at3 e n h i = 0 := by
    simp [r, Fin.sum_univ_three]
    calc
      q 1 • e + q 0 • n + (q 0 + q 1 + q 2) • h =
          q 0 • (n + h) + q 1 • (e + h) + q 2 • h := by
        apply funext_three <;> simp [smul_add] <;> ring
      _ = 0 := hrel'
  have hq0 : q 0 = 0 := by simpa [r] using hlin r hrrel 1
  have hq1 : q 1 = 0 := by simpa [r] using hlin r hrrel 0
  have hq2 : q 2 = 0 := by
    have := hlin r hrrel 2
    simpa [r, hq0, hq1] using this
  intro i
  fin_cases i
  · exact hq0
  · exact hq1
  · exact hq2

/-- In a non-straight table, the cube of an element independent from its
square has unique coordinates in the span of that element and its square. -/
theorem cubic_relation_of_pairIndependent_square
    {c : StructureConstants K 3} (hs : ¬ IsStraight c)
    {f : V K} (hpair : PairIndependent f (c.mul f f)) :
    ∃ a b : K,
      c.mul (c.mul f f) f = a • f + b • c.mul f f := by
  obtain ⟨g, hbasis⟩ := exists_third_of_pairIndependent hpair
  exact exists_two_coefficients_of_not_tripleIndependent hbasis
    (fun h => hs ⟨f, h⟩)

/-- Package the basis and cubic relation supplied by wavedness. -/
theorem exists_waved_generator_basis
    {c : StructureConstants K 3} (hw : IsWaved c) :
    ∃ f g : V K, ∃ a b : K,
      TripleIndependent f (c.mul f f) g ∧
      c.mul (c.mul f f) f = a • f + b • c.mul f f := by
  obtain ⟨f, hpair⟩ :=
    exists_pairIndependent_square_of_not_isCurled hw.1
  obtain ⟨g, hbasis⟩ := exists_third_of_pairIndependent hpair
  obtain ⟨a, b, hcubic⟩ :=
    cubic_relation_of_pairIndependent_square hw.2 hpair
  exact ⟨f, g, a, b, hbasis, hcubic⟩

/-- Associativity makes the two possible orientations of the cube agree. -/
theorem cube_commutes_of_associative
    {c : StructureConstants K 3} (ha : c.MultiplicationAssociative)
    (f : V K) :
    c.mul f (c.mul f f) = c.mul (c.mul f f) f := by
  exact (ha f f f).symm

/-- Once `f³ = a f + b f²`, associativity determines `f² f²`. -/
theorem fourth_power_of_cubic_relation
    {c : StructureConstants K 3} (ha : c.MultiplicationAssociative)
    {f : V K} {a b : K}
    (hcubic : c.mul (c.mul f f) f = a • f + b • c.mul f f) :
    c.mul (c.mul f f) (c.mul f f) =
      (a * b) • f + (a + b * b) • c.mul f f := by
  let f2 := c.mul f f
  have hff2 : c.mul f f2 = a • f + b • f2 := by
    calc
      c.mul f f2 = c.mul f (c.mul f f) := rfl
      _ = c.mul (c.mul f f) f := cube_commutes_of_associative ha f
      _ = a • f + b • f2 := by simpa [f2] using hcubic
  calc
    c.mul f2 f2 = c.mul (c.mul f f) f2 := rfl
    _ = c.mul f (c.mul f f2) := ha f f f2
    _ = c.mul f (a • f + b • f2) := by rw [hff2]
    _ = a • f2 + b • (a • f + b • f2) := by
      change (mulLinear c f) (a • f + b • f2) = _
      rw [map_add, map_smul, map_smul, mulLinear_apply, mulLinear_apply,
        hff2]
    _ = (a * b) • f + (a + b * b) • f2 := by
      apply funext_three <;> simp [smul_add, smul_smul] <;> ring

/-! ## Normal forms for the generated plane -/

/-- The multiplication laws of the two-dimensional nilpotent chain, written
for a pair of ambient vectors. -/
def IsNilpotentChainPair (c : StructureConstants K 3) (e n : V K) : Prop :=
  c.mul e e = 0 ∧ c.mul e n = 0 ∧ c.mul n e = 0 ∧ c.mul n n = e

/-- The multiplication laws of an idempotent plus an annihilating direction. -/
def IsIdempotentAnnihilatorPair
    (c : StructureConstants K 3) (e n : V K) : Prop :=
  c.mul e e = e ∧ c.mul e n = 0 ∧ c.mul n e = 0 ∧ c.mul n n = 0

/-- The multiplication laws of a unital quadratic plane `p² = delta e`. -/
def IsQuadraticPair
    (c : StructureConstants K 3) (delta : K) (e p : V K) : Prop :=
  c.mul e e = e ∧ c.mul e p = p ∧ c.mul p e = p ∧
  c.mul p p = delta • e

/-- Associativity leaves only six scalar parameters around a nilpotent-chain
plane.  The equations at the end are the remaining constraints needed below.
-/
theorem nilpotentChain_extension_parameters
    {c : StructureConstants K 3} (ha : c.MultiplicationAssociative)
    {e n g : V K} (hlin : TripleIndependent e n g)
    (hnil : IsNilpotentChainPair c e n) :
    ∃ c0 d0 h0 h1 h2 lambda : K,
      c.mul e g = lambda • e ∧
      c.mul g e = lambda • e ∧
      c.mul n g = c0 • e + lambda • n ∧
      c.mul g n = d0 • e + lambda • n ∧
      c.mul g g = h0 • e + h1 • n + h2 • g ∧
      lambda * (lambda - h2) = 0 ∧
      h1 = c0 * (2 * lambda - h2) ∧
      h1 = d0 * (2 * lambda - h2) := by
  rcases hnil with ⟨hee, hen, hne, hnn⟩
  obtain ⟨a0, a1, a2, heg⟩ :=
    exists_three_coefficients (c.mul e g) hlin
  obtain ⟨b0, b1, b2, hge⟩ :=
    exists_three_coefficients (c.mul g e) hlin
  obtain ⟨c0, c1, c2, hng⟩ :=
    exists_three_coefficients (c.mul n g) hlin
  obtain ⟨d0, d1, d2, hgn⟩ :=
    exists_three_coefficients (c.mul g n) hlin
  obtain ⟨h0, h1, h2, hgg⟩ :=
    exists_three_coefficients (c.mul g g) hlin
  have heeg : c.mul e (c.mul e g) = 0 := by
    calc
      c.mul e (c.mul e g) = c.mul (c.mul e e) g := (ha e e g).symm
      _ = 0 := by rw [hee]; simp [← mulLinear_apply]
  have heegExpansion : c.mul e (c.mul e g) =
      (a2 * a0) • e + (a2 * a1) • n + (a2 * a2) • g := by
    rw [heg]
    change (mulLinear c e) (a0 • e + a1 • n + a2 • g) = _
    rw [map_add, map_add, map_smul, map_smul, map_smul,
      mulLinear_apply, mulLinear_apply, mulLinear_apply, hee, hen, heg]
    apply funext_three <;> simp [smul_add, smul_smul] <;> ring
  have ha2sq : a2 * a2 = 0 := by
    have hcoeff :=
      (tripleIndependent_smul_add_smul_add_smul_iff hlin
        (a2 * a0) (a2 * a1) (a2 * a2) 0 0 0).mp
        (heegExpansion.symm.trans (by simpa using heeg))
    exact hcoeff.2.2
  have ha2 : a2 = 0 := by
    rcases mul_eq_zero.mp ha2sq with h | h <;> exact h
  have hnng : c.mul e g = c.mul n (c.mul n g) := by
    calc
      c.mul e g = c.mul (c.mul n n) g := by rw [hnn]
      _ = c.mul n (c.mul n g) := ha n n g
  have hnngExpansion : c.mul n (c.mul n g) =
      (c1 + c2 * c0) • e + (c2 * c1) • n + (c2 * c2) • g := by
    rw [hng]
    change (mulLinear c n) (c0 • e + c1 • n + c2 • g) = _
    rw [map_add, map_add, map_smul, map_smul, map_smul,
      mulLinear_apply, mulLinear_apply, mulLinear_apply, hne, hnn, hng]
    apply funext_three <;> simp [smul_add, smul_smul] <;> ring
  have hleftCoeffs :=
    (tripleIndependent_smul_add_smul_add_smul_iff hlin
      a0 a1 a2 (c1 + c2 * c0) (c2 * c1) (c2 * c2)).mp
      (heg.symm.trans (hnng.trans hnngExpansion))
  have hc2sq : c2 * c2 = 0 := by simpa [ha2] using hleftCoeffs.2.2
  have hc2 : c2 = 0 := by
    rcases mul_eq_zero.mp hc2sq with h | h <;> exact h
  have ha0 : a0 = c1 := by simpa [hc2] using hleftCoeffs.1
  have ha1 : a1 = 0 := by simpa [hc2] using hleftCoeffs.2.1
  have heg' : c.mul e g = c1 • e := by
    simpa [ha0, ha1, ha2] using heg
  have hng' : c.mul n g = c0 • e + c1 • n := by
    simpa [hc2] using hng
  have hgee : c.mul (c.mul g e) e = 0 := by
    calc
      c.mul (c.mul g e) e = c.mul g (c.mul e e) := ha g e e
      _ = 0 := by rw [hee]; simp [← mulLinear_apply]
  have hgeeExpansion : c.mul (c.mul g e) e =
      (b2 * b0) • e + (b2 * b1) • n + (b2 * b2) • g := by
    rw [hge]
    change (mulLinear c (b0 • e + b1 • n + b2 • g)) e = _
    rw [(mulLinear c).map_add, (mulLinear c).map_add,
      (mulLinear c).map_smul, (mulLinear c).map_smul,
      (mulLinear c).map_smul, LinearMap.add_apply, LinearMap.add_apply,
      LinearMap.smul_apply, LinearMap.smul_apply, LinearMap.smul_apply,
      mulLinear_apply, mulLinear_apply, mulLinear_apply, hee, hne, hge]
    apply funext_three <;> simp [smul_add, smul_smul] <;> ring
  have hb2sq : b2 * b2 = 0 := by
    have hcoeff :=
      (tripleIndependent_smul_add_smul_add_smul_iff hlin
        (b2 * b0) (b2 * b1) (b2 * b2) 0 0 0).mp
        (hgeeExpansion.symm.trans (by simpa using hgee))
    exact hcoeff.2.2
  have hb2 : b2 = 0 := by
    rcases mul_eq_zero.mp hb2sq with h | h <;> exact h
  have hgnn : c.mul g e = c.mul (c.mul g n) n := by
    calc
      c.mul g e = c.mul g (c.mul n n) := by rw [hnn]
      _ = c.mul (c.mul g n) n := (ha g n n).symm
  have hgnnExpansion : c.mul (c.mul g n) n =
      (d1 + d2 * d0) • e + (d2 * d1) • n + (d2 * d2) • g := by
    rw [hgn]
    change (mulLinear c (d0 • e + d1 • n + d2 • g)) n = _
    rw [(mulLinear c).map_add, (mulLinear c).map_add,
      (mulLinear c).map_smul, (mulLinear c).map_smul,
      (mulLinear c).map_smul, LinearMap.add_apply, LinearMap.add_apply,
      LinearMap.smul_apply, LinearMap.smul_apply, LinearMap.smul_apply,
      mulLinear_apply, mulLinear_apply, mulLinear_apply, hen, hnn, hgn]
    apply funext_three <;> simp [smul_add, smul_smul] <;> ring
  have hrightCoeffs :=
    (tripleIndependent_smul_add_smul_add_smul_iff hlin
      b0 b1 b2 (d1 + d2 * d0) (d2 * d1) (d2 * d2)).mp
      (hge.symm.trans (hgnn.trans hgnnExpansion))
  have hd2sq : d2 * d2 = 0 := by simpa [hb2] using hrightCoeffs.2.2
  have hd2 : d2 = 0 := by
    rcases mul_eq_zero.mp hd2sq with h | h <;> exact h
  have hb0 : b0 = d1 := by simpa [hd2] using hrightCoeffs.1
  have hb1 : b1 = 0 := by simpa [hd2] using hrightCoeffs.2.1
  have hge' : c.mul g e = d1 • e := by
    simpa [hb0, hb1, hb2] using hge
  have hgn' : c.mul g n = d0 • e + d1 • n := by
    simpa [hd2] using hgn
  have hngn := ha n g n
  have hngnLeft : c.mul (c.mul n g) n = c1 • e := by
    rw [hng']
    change (mulLinear c (c0 • e + c1 • n)) n = c1 • e
    rw [(mulLinear c).map_add, (mulLinear c).map_smul,
      (mulLinear c).map_smul, LinearMap.add_apply, LinearMap.smul_apply,
      LinearMap.smul_apply, mulLinear_apply, mulLinear_apply, hen, hnn]
    simp
  have hngnRight : c.mul n (c.mul g n) = d1 • e := by
    rw [hgn']
    change (mulLinear c n) (d0 • e + d1 • n) = d1 • e
    rw [map_add, map_smul, map_smul, mulLinear_apply, mulLinear_apply,
      hne, hnn]
    simp
  have hc1d1 : c1 = d1 := by
    have hv : c1 • e + (0 : K) • n + (0 : K) • g =
        d1 • e + (0 : K) • n + (0 : K) • g := by
      simpa [hngnLeft, hngnRight] using hngn
    exact (tripleIndependent_smul_add_smul_add_smul_iff hlin
      c1 0 0 d1 0 0).mp hv |>.1
  have hge'' : c.mul g e = c1 • e := by simpa [hc1d1] using hge'
  have hgn'' : c.mul g n = d0 • e + c1 • n := by
    simpa [hc1d1] using hgn'
  have hngg := ha n g g
  have hnggLeft : c.mul (c.mul n g) g =
      (2 * c0 * c1) • e + (c1 * c1) • n + (0 : K) • g := by
    rw [hng']
    change (mulLinear c (c0 • e + c1 • n)) g = _
    rw [(mulLinear c).map_add, (mulLinear c).map_smul,
      (mulLinear c).map_smul, LinearMap.add_apply, LinearMap.smul_apply,
      LinearMap.smul_apply, mulLinear_apply, mulLinear_apply, heg', hng']
    apply funext_three <;> simp [smul_add, smul_smul] <;> ring
  have hnggRight : c.mul n (c.mul g g) =
      (h1 + h2 * c0) • e + (h2 * c1) • n + (0 : K) • g := by
    rw [hgg]
    change (mulLinear c n) (h0 • e + h1 • n + h2 • g) = _
    rw [map_add, map_add, map_smul, map_smul, map_smul,
      mulLinear_apply, mulLinear_apply, mulLinear_apply, hne, hnn, hng']
    apply funext_three <;> simp [smul_add, smul_smul] <;> ring
  have hnggCoeffs :=
    (tripleIndependent_smul_add_smul_add_smul_iff hlin
      (2 * c0 * c1) (c1 * c1) 0
      (h1 + h2 * c0) (h2 * c1) 0).mp
      (hnggLeft.symm.trans (hngg.trans hnggRight))
  have hlambda : c1 * (c1 - h2) = 0 := by
    linear_combination hnggCoeffs.2.1
  have hh1c : h1 = c0 * (2 * c1 - h2) := by
    linear_combination -hnggCoeffs.1
  have hggn := ha g g n
  have hggnLeft : c.mul (c.mul g g) n =
      (h1 + h2 * d0) • e + (h2 * c1) • n + (0 : K) • g := by
    rw [hgg]
    change (mulLinear c (h0 • e + h1 • n + h2 • g)) n = _
    rw [(mulLinear c).map_add, (mulLinear c).map_add,
      (mulLinear c).map_smul, (mulLinear c).map_smul,
      (mulLinear c).map_smul, LinearMap.add_apply, LinearMap.add_apply,
      LinearMap.smul_apply, LinearMap.smul_apply, LinearMap.smul_apply,
      mulLinear_apply, mulLinear_apply, mulLinear_apply, hen, hnn, hgn'']
    apply funext_three <;> simp [smul_add, smul_smul] <;> ring
  have hggnRight : c.mul g (c.mul g n) =
      (2 * d0 * c1) • e + (c1 * c1) • n + (0 : K) • g := by
    rw [hgn'']
    change (mulLinear c g) (d0 • e + c1 • n) = _
    rw [map_add, map_smul, map_smul, mulLinear_apply, mulLinear_apply,
      hge'', hgn'']
    apply funext_three <;> simp [smul_add, smul_smul] <;> ring
  have hggnCoeffs :=
    (tripleIndependent_smul_add_smul_add_smul_iff hlin
      (h1 + h2 * d0) (h2 * c1) 0
      (2 * d0 * c1) (c1 * c1) 0).mp
      (hggnLeft.symm.trans (hggn.trans hggnRight))
  have hh1d : h1 = d0 * (2 * c1 - h2) := by
    linear_combination hggnCoeffs.1
  exact ⟨c0, d0, h0, h1, h2, c1, heg', hge'', hng', hgn'', hgg,
    hlambda, hh1c, hh1d⟩

/-- In the nilpotent-chain extension, a nonzero scalar action on the chain
produces an explicit identity for the whole algebra. -/
theorem nilpotentChain_extension_hasIdentity_of_lambda_ne
    {c : StructureConstants K 3}
    {e n g : V K} (hlin : TripleIndependent e n g)
    (hnil : IsNilpotentChainPair c e n)
    {c0 d0 h0 h1 h2 lambda : K}
    (heg : c.mul e g = lambda • e)
    (hge : c.mul g e = lambda • e)
    (hng : c.mul n g = c0 • e + lambda • n)
    (hgn : c.mul g n = d0 • e + lambda • n)
    (hgg : c.mul g g = h0 • e + h1 • n + h2 • g)
    (hlambda : lambda * (lambda - h2) = 0)
    (hh1c : h1 = c0 * (2 * lambda - h2))
    (hh1d : h1 = d0 * (2 * lambda - h2))
    (hlambda0 : lambda ≠ 0) :
    HasTwoSidedIdentity c := by
  rcases hnil with ⟨hee, hen, hne, hnn⟩
  have hlambdaDiff : lambda - h2 = 0 :=
    (mul_eq_zero.mp hlambda).resolve_left hlambda0
  have hh2 : h2 = lambda := (sub_eq_zero.mp hlambdaDiff).symm
  have hh1c' : h1 = c0 * lambda := by
    rw [hh2] at hh1c
    convert hh1c using 1 <;> ring
  have hh1d' : h1 = d0 * lambda := by
    rw [hh2] at hh1d
    convert hh1d using 1 <;> ring
  have hc0d0 : c0 = d0 := by
    apply mul_right_cancel₀ hlambda0
    exact hh1c'.symm.trans hh1d'
  let u : V K := g - c0 • n
  let q : K := h0 - c0 * c0
  have hlinu : TripleIndependent e n u := by
    simpa [u, sub_eq_add_neg, add_comm] using
      tripleIndependent_replace_third hlin 0 (-c0) 1 one_ne_zero
  have heu : c.mul e u = lambda • e := by
    calc
      c.mul e u = c.mul e (g - c0 • n) := by rfl
      _ = c.mul e g - c0 • c.mul e n := by
        change (mulLinear c e) (g - c0 • n) = _
        rw [map_sub, map_smul, mulLinear_apply, mulLinear_apply]
      _ = lambda • e := by rw [heg, hen]; simp
  have hue : c.mul u e = lambda • e := by
    calc
      c.mul u e = c.mul (g - c0 • n) e := by rfl
      _ = c.mul g e - c0 • c.mul n e := by
        change (mulLinear c (g - c0 • n)) e = _
        rw [(mulLinear c).map_sub, (mulLinear c).map_smul,
          LinearMap.sub_apply, LinearMap.smul_apply, mulLinear_apply,
          mulLinear_apply]
      _ = lambda • e := by rw [hge, hne]; simp
  have hnu : c.mul n u = lambda • n := by
    calc
      c.mul n u = c.mul n (g - c0 • n) := by rfl
      _ = c.mul n g - c0 • c.mul n n := by
        change (mulLinear c n) (g - c0 • n) = _
        rw [map_sub, map_smul, mulLinear_apply, mulLinear_apply]
      _ = lambda • n := by rw [hng, hnn]; simp
  have hun : c.mul u n = lambda • n := by
    calc
      c.mul u n = c.mul (g - c0 • n) n := by rfl
      _ = c.mul g n - c0 • c.mul n n := by
        change (mulLinear c (g - c0 • n)) n = _
        rw [(mulLinear c).map_sub, (mulLinear c).map_smul,
          LinearMap.sub_apply, LinearMap.smul_apply, mulLinear_apply,
          mulLinear_apply]
      _ = lambda • n := by rw [hgn, ← hc0d0, hnn]; simp
  have huu : c.mul u u = q • e + lambda • u := by
    calc
      c.mul u u = c.mul (g + (-c0) • n) (g + (-c0) • n) := by
        simp [u, sub_eq_add_neg]
      _ = ((1 : K) * 1) • c.mul g g +
            ((1 : K) * (-c0)) • c.mul g n +
              ((-c0) * 1) • c.mul n g +
                ((-c0) * (-c0)) • c.mul n n :=
        by simpa only [one_smul] using
          mul_linearCombination_pair_three c g n 1 (-c0) 1 (-c0)
      _ = q • e + lambda • u := by
        have hgn' : c.mul g n = c0 • e + lambda • n := by
          simpa [hc0d0] using hgn
        rw [hgg, hgn', hng, hnn, hh2, hh1c']
        apply funext_three <;>
          simp [q, u, sub_eq_add_neg, smul_add, smul_smul] <;> ring
  let v : V K := u - (q / lambda) • e
  have hlinv : TripleIndependent e n v := by
    have hreplace :=
      tripleIndependent_replace_third hlinu (-(q / lambda)) 0 1 one_ne_zero
    simpa [v, sub_eq_add_neg, add_comm, add_left_comm, add_assoc] using hreplace
  have hev : c.mul e v = lambda • e := by
    calc
      c.mul e v = c.mul e (u - (q / lambda) • e) := by rfl
      _ = c.mul e u - (q / lambda) • c.mul e e := by
        change (mulLinear c e) (u - (q / lambda) • e) = _
        rw [map_sub, map_smul, mulLinear_apply, mulLinear_apply]
      _ = lambda • e := by rw [heu, hee]; simp
  have hve : c.mul v e = lambda • e := by
    calc
      c.mul v e = c.mul (u - (q / lambda) • e) e := by rfl
      _ = c.mul u e - (q / lambda) • c.mul e e := by
        change (mulLinear c (u - (q / lambda) • e)) e = _
        rw [(mulLinear c).map_sub, (mulLinear c).map_smul,
          LinearMap.sub_apply, LinearMap.smul_apply, mulLinear_apply,
          mulLinear_apply]
      _ = lambda • e := by rw [hue, hee]; simp
  have hnv : c.mul n v = lambda • n := by
    calc
      c.mul n v = c.mul n (u - (q / lambda) • e) := by rfl
      _ = c.mul n u - (q / lambda) • c.mul n e := by
        change (mulLinear c n) (u - (q / lambda) • e) = _
        rw [map_sub, map_smul, mulLinear_apply, mulLinear_apply]
      _ = lambda • n := by rw [hnu, hne]; simp
  have hvn : c.mul v n = lambda • n := by
    calc
      c.mul v n = c.mul (u - (q / lambda) • e) n := by rfl
      _ = c.mul u n - (q / lambda) • c.mul e n := by
        change (mulLinear c (u - (q / lambda) • e)) n = _
        rw [(mulLinear c).map_sub, (mulLinear c).map_smul,
          LinearMap.sub_apply, LinearMap.smul_apply, mulLinear_apply,
          mulLinear_apply]
      _ = lambda • n := by rw [hun, hen]; simp
  have hvv : c.mul v v = lambda • v := by
    calc
      c.mul v v = c.mul (u + (-(q / lambda)) • e)
          (u + (-(q / lambda)) • e) := by simp [v, sub_eq_add_neg]
      _ = ((1 : K) * 1) • c.mul u u +
            ((1 : K) * (-(q / lambda))) • c.mul u e +
              ((-(q / lambda)) * 1) • c.mul e u +
                ((-(q / lambda)) * (-(q / lambda))) • c.mul e e :=
        by simpa only [one_smul] using
          mul_linearCombination_pair_three c u e 1 (-(q / lambda))
            1 (-(q / lambda))
      _ = lambda • v := by
        rw [huu, hue, heu, hee]
        apply funext_three <;>
          simp [v, sub_eq_add_neg, smul_add, smul_smul] <;>
            field_simp [hlambda0] <;> ring
  let one : V K := lambda⁻¹ • v
  have honee : c.mul one e = e ∧ c.mul e one = e := by
    constructor
    · calc
        c.mul one e = (lambda⁻¹ * 1) • c.mul v e := by
          simpa [one] using mul_smul_smul_three c lambda⁻¹ 1 v e
        _ = e := by rw [hve]; simp [smul_smul, hlambda0]
    · calc
        c.mul e one = (1 * lambda⁻¹) • c.mul e v := by
          simpa [one] using mul_smul_smul_three c 1 lambda⁻¹ e v
        _ = e := by rw [hev]; simp [smul_smul, hlambda0]
  have honen : c.mul one n = n ∧ c.mul n one = n := by
    constructor
    · calc
        c.mul one n = (lambda⁻¹ * 1) • c.mul v n := by
          simpa [one] using mul_smul_smul_three c lambda⁻¹ 1 v n
        _ = n := by rw [hvn]; simp [smul_smul, hlambda0]
    · calc
        c.mul n one = (1 * lambda⁻¹) • c.mul n v := by
          simpa [one] using mul_smul_smul_three c 1 lambda⁻¹ n v
        _ = n := by rw [hnv]; simp [smul_smul, hlambda0]
  have honev : c.mul one v = v ∧ c.mul v one = v := by
    constructor
    · calc
        c.mul one v = (lambda⁻¹ * 1) • c.mul v v := by
          simpa [one] using mul_smul_smul_three c lambda⁻¹ 1 v v
        _ = v := by rw [hvv]; simp [smul_smul, hlambda0]
    · calc
        c.mul v one = (1 * lambda⁻¹) • c.mul v v := by
          simpa [one] using mul_smul_smul_three c 1 lambda⁻¹ v v
        _ = v := by rw [hvv]; simp [smul_smul, hlambda0]
  exact hasTwoSidedIdentity_of_basis hlinv honee honen honev

/-- If the complementary direction has a nonzero linear term in its square,
the nilpotent-chain extension contains a straight generator. -/
theorem nilpotentChain_extension_isStraight_of_square_linear_ne
    {c : StructureConstants K 3}
    {e n u : V K} (hlin : TripleIndependent e n u)
    (hnil : IsNilpotentChainPair c e n)
    {k q r : K}
    (heu : c.mul e u = 0) (hue : c.mul u e = 0)
    (hnu : c.mul n u = 0) (hun : c.mul u n = k • e)
    (huu : c.mul u u = q • e + r • u)
    (hkr : k * r = 0) (hr : r ≠ 0) :
    IsStraight c := by
  rcases hnil with ⟨hee, hen, hne, hnn⟩
  have hk : k = 0 := (mul_eq_zero.mp hkr).resolve_right hr
  let alpha : K := r⁻¹
  let beta : K := q / (r * r)
  let h : V K := alpha • u + beta • e
  have halpha : alpha ≠ 0 := inv_ne_zero hr
  have hlinh : TripleIndependent e n h := by
    have hreplace :=
      tripleIndependent_replace_third hlin beta 0 alpha halpha
    simpa [h, add_comm, add_left_comm, add_assoc] using hreplace
  have heh : c.mul e h = 0 := by
    rw [show h = alpha • u + beta • e by rfl]
    change (mulLinear c e) (alpha • u + beta • e) = 0
    rw [map_add, map_smul, map_smul, mulLinear_apply, mulLinear_apply,
      heu, hee]
    simp
  have hhe : c.mul h e = 0 := by
    rw [show h = alpha • u + beta • e by rfl]
    change (mulLinear c (alpha • u + beta • e)) e = 0
    rw [(mulLinear c).map_add, (mulLinear c).map_smul,
      (mulLinear c).map_smul, LinearMap.add_apply, LinearMap.smul_apply,
      LinearMap.smul_apply, mulLinear_apply, mulLinear_apply, hue, hee]
    simp
  have hnh : c.mul n h = 0 := by
    rw [show h = alpha • u + beta • e by rfl]
    change (mulLinear c n) (alpha • u + beta • e) = 0
    rw [map_add, map_smul, map_smul, mulLinear_apply, mulLinear_apply,
      hnu, hne]
    simp
  have hhn : c.mul h n = 0 := by
    rw [show h = alpha • u + beta • e by rfl]
    change (mulLinear c (alpha • u + beta • e)) n = 0
    rw [(mulLinear c).map_add, (mulLinear c).map_smul,
      (mulLinear c).map_smul, LinearMap.add_apply, LinearMap.smul_apply,
      LinearMap.smul_apply, mulLinear_apply, mulLinear_apply, hun, hen, hk]
    simp
  have hhh : c.mul h h = h := by
    calc
      c.mul h h = c.mul (alpha • u + beta • e) (alpha • u + beta • e) := by rfl
      _ = (alpha * alpha) • c.mul u u +
            (alpha * beta) • c.mul u e +
              (beta * alpha) • c.mul e u +
                (beta * beta) • c.mul e e :=
        mul_linearCombination_pair_three c u e alpha beta alpha beta
      _ = h := by
        rw [huu, hue, heu, hee]
        apply funext_three <;>
          simp [h, alpha, beta, smul_add, smul_smul] <;>
            field_simp [hr] <;> ring
  let x : V K := n + h
  have hxx : c.mul x x = e + h := by
    calc
      c.mul x x = c.mul ((1 : K) • n + (1 : K) • h)
          ((1 : K) • n + (1 : K) • h) := by simp [x]
      _ = ((1 : K) * 1) • c.mul n n +
            ((1 : K) * 1) • c.mul n h +
              ((1 : K) * 1) • c.mul h n +
                ((1 : K) * 1) • c.mul h h :=
        mul_linearCombination_pair_three c n h 1 1 1 1
      _ = e + h := by rw [hnn, hnh, hhn, hhh]; simp
  have hxxx : c.mul (c.mul x x) x = h := by
    rw [hxx]
    calc
      c.mul (e + h) x = c.mul ((1 : K) • e + (1 : K) • h)
          ((1 : K) • n + (1 : K) • h) := by simp [x]
      _ = ((1 : K) * 1) • c.mul e n +
            ((1 : K) * 1) • c.mul e h +
              ((1 : K) * 1) • c.mul h n +
                ((1 : K) * 1) • c.mul h h := by
        simpa using mul_add_add_three c e h n h
      _ = h := by rw [hen, heh, hhn, hhh]; simp
  refine ⟨x, ?_⟩
  rw [hxxx, hxx]
  simpa only [x] using tripleIndependent_nil_add_idempotent hlinh

/-- Complete reduction of the nilpotent-chain plane inside a nonunital waved
algebra.  After replacing the complementary basis vector, only two parameters
remain:

`n²=e`, `u n = k e`, `u²=q e`,

and all other products involving `e` or `n u` vanish.
-/
theorem nonunital_waved_nilpotentChain_normal_form
    {c : StructureConstants K 3} (ha : c.MultiplicationAssociative)
    (hnonunit : ¬ HasTwoSidedIdentity c)
    (hnotstraight : ¬ IsStraight c)
    {e n g : V K} (hlin : TripleIndependent e n g)
    (hnil : IsNilpotentChainPair c e n) :
    ∃ u : V K, ∃ k q : K,
      TripleIndependent e n u ∧
      c.mul e u = 0 ∧ c.mul u e = 0 ∧
      c.mul n u = 0 ∧ c.mul u n = k • e ∧
      c.mul u u = q • e := by
  obtain ⟨c0, d0, h0, h1, h2, lambda,
      heg, hge, hng, hgn, hgg, hlambda, hh1c, hh1d⟩ :=
    nilpotentChain_extension_parameters ha hlin hnil
  have hlambda0 : lambda = 0 := by
    by_contra hlambdaNe
    exact hnonunit
      (nilpotentChain_extension_hasIdentity_of_lambda_ne hlin hnil
        heg hge hng hgn hgg hlambda hh1c hh1d hlambdaNe)
  have heg0 : c.mul e g = 0 := by simpa [hlambda0] using heg
  have hge0 : c.mul g e = 0 := by simpa [hlambda0] using hge
  have hng0 : c.mul n g = c0 • e := by simpa [hlambda0] using hng
  have hgn0 : c.mul g n = d0 • e := by simpa [hlambda0] using hgn
  have hh1c0 : h1 = -(c0 * h2) := by
    rw [hlambda0] at hh1c
    simpa using hh1c
  have hh1d0 : h1 = -(d0 * h2) := by
    rw [hlambda0] at hh1d
    simpa using hh1d
  let u : V K := g - c0 • n
  let k : K := d0 - c0
  let q : K := h0 - c0 * d0
  let r : K := h2
  have hlinu : TripleIndependent e n u := by
    simpa [u, sub_eq_add_neg, add_comm] using
      tripleIndependent_replace_third hlin 0 (-c0) 1 one_ne_zero
  rcases hnil with ⟨hee, hen, hne, hnn⟩
  have heu : c.mul e u = 0 := by
    calc
      c.mul e u = c.mul e (g - c0 • n) := by rfl
      _ = c.mul e g - c0 • c.mul e n := by
        change (mulLinear c e) (g - c0 • n) = _
        rw [map_sub, map_smul, mulLinear_apply, mulLinear_apply]
      _ = 0 := by rw [heg0, hen]; simp
  have hue : c.mul u e = 0 := by
    calc
      c.mul u e = c.mul (g - c0 • n) e := by rfl
      _ = c.mul g e - c0 • c.mul n e := by
        change (mulLinear c (g - c0 • n)) e = _
        rw [(mulLinear c).map_sub, (mulLinear c).map_smul,
          LinearMap.sub_apply, LinearMap.smul_apply, mulLinear_apply,
          mulLinear_apply]
      _ = 0 := by rw [hge0, hne]; simp
  have hnu : c.mul n u = 0 := by
    calc
      c.mul n u = c.mul n (g - c0 • n) := by rfl
      _ = c.mul n g - c0 • c.mul n n := by
        change (mulLinear c n) (g - c0 • n) = _
        rw [map_sub, map_smul, mulLinear_apply, mulLinear_apply]
      _ = 0 := by rw [hng0, hnn]; simp
  have hun : c.mul u n = k • e := by
    calc
      c.mul u n = c.mul (g - c0 • n) n := by rfl
      _ = c.mul g n - c0 • c.mul n n := by
        change (mulLinear c (g - c0 • n)) n = _
        rw [(mulLinear c).map_sub, (mulLinear c).map_smul,
          LinearMap.sub_apply, LinearMap.smul_apply, mulLinear_apply,
          mulLinear_apply]
      _ = k • e := by rw [hgn0, hnn]; simp [k, sub_smul]
  have hkr : k * r = 0 := by
    dsimp [k, r]
    linear_combination hh1d0 - hh1c0
  have huu : c.mul u u = q • e + r • u := by
    calc
      c.mul u u = c.mul (g + (-c0) • n) (g + (-c0) • n) := by
        simp [u, sub_eq_add_neg]
      _ = ((1 : K) * 1) • c.mul g g +
            ((1 : K) * (-c0)) • c.mul g n +
              ((-c0) * 1) • c.mul n g +
                ((-c0) * (-c0)) • c.mul n n :=
        by simpa only [one_smul] using
          mul_linearCombination_pair_three c g n 1 (-c0) 1 (-c0)
      _ = q • e + r • u := by
        rw [hgg, hgn0, hng0, hnn, hh1c0]
        apply funext_three <;>
          simp [q, r, u, sub_eq_add_neg, smul_add, smul_smul] <;> ring
  have hr0 : r = 0 := by
    by_contra hr
    apply hnotstraight
    exact nilpotentChain_extension_isStraight_of_square_linear_ne
      hlinu ⟨hee, hen, hne, hnn⟩ heu hue hnu hun huu hkr hr
  refine ⟨u, k, q, hlinu, heu, hue, hnu, hun, ?_⟩
  simpa [hr0] using huu

/-! ### Identification of the nilpotent-chain normal forms -/

theorem isomorphic_w1_of_nilpotentChain_normal_zero
    {c : StructureConstants K 3} {e n u : V K}
    (hlin : TripleIndependent e n u)
    (hnil : IsNilpotentChainPair c e n)
    (heu : c.mul e u = 0) (hue : c.mul u e = 0)
    (hnu : c.mul n u = 0) (hun : c.mul u n = 0)
    (huu : c.mul u u = 0) :
    Isomorphic c (fixedTable .w1) := by
  rcases hnil with ⟨hee, hen, hne, hnn⟩
  have hlin' : TripleIndependent e u n := tripleIndependent_swap_last hlin
  let E := basisEquivOfTripleIndependent hlin'
  let T : TableEquiv (fixedTable (K := K) .w1) c :=
    TableEquiv.ofBasis E (by
      intro i j
      fin_cases i <;> fin_cases j <;>
        simp [fixedTable, E, hee, hen, hne, hnn, heu, hue, hnu, hun, huu])
  exact ⟨T.symm⟩

theorem isomorphic_w2_of_nilpotentChain_normal
    {c : StructureConstants K 3} {e n u : V K} {k : K}
    (hlin : TripleIndependent e n u)
    (hnil : IsNilpotentChainPair c e n)
    (heu : c.mul e u = 0) (hue : c.mul u e = 0)
    (hnu : c.mul n u = 0) (hun : c.mul u n = k • e)
    (huu : c.mul u u = 0) (hk : k ≠ 0) :
    Isomorphic c (fixedTable .w2) := by
  rcases hnil with ⟨hee, hen, hne, hnn⟩
  let v : V K := k⁻¹ • u
  have hkinv : k⁻¹ ≠ 0 := inv_ne_zero hk
  have hlinv : TripleIndependent e n v := by
    simpa [v] using
      tripleIndependent_replace_third hlin 0 0 k⁻¹ hkinv
  have hev : c.mul e v = 0 := by
    calc
      c.mul e v = (1 * k⁻¹) • c.mul e u := by
        simpa [v] using mul_smul_smul_three c 1 k⁻¹ e u
      _ = 0 := by rw [heu]; simp
  have hve : c.mul v e = 0 := by
    calc
      c.mul v e = (k⁻¹ * 1) • c.mul u e := by
        simpa [v] using mul_smul_smul_three c k⁻¹ 1 u e
      _ = 0 := by rw [hue]; simp
  have hnv : c.mul n v = 0 := by
    calc
      c.mul n v = (1 * k⁻¹) • c.mul n u := by
        simpa [v] using mul_smul_smul_three c 1 k⁻¹ n u
      _ = 0 := by rw [hnu]; simp
  have hvn : c.mul v n = e := by
    calc
      c.mul v n = (k⁻¹ * 1) • c.mul u n := by
        simpa [v] using mul_smul_smul_three c k⁻¹ 1 u n
      _ = e := by rw [hun]; simp [smul_smul, hk]
  have hvv : c.mul v v = 0 := by
    calc
      c.mul v v = (k⁻¹ * k⁻¹) • c.mul u u := by
        simpa [v] using mul_smul_smul_three c k⁻¹ k⁻¹ u u
      _ = 0 := by rw [huu]; simp
  let f : V K := n - v
  have hlin' : TripleIndependent e f v := by
    simpa [f, sub_eq_add_neg] using
      tripleIndependent_add_smul_third_to_second hlinv (-1)
  have hef : c.mul e f = 0 := by
    calc
      c.mul e f = c.mul e (n - v) := by rfl
      _ = c.mul e n - c.mul e v := by
        change (mulLinear c e) (n - v) = _
        rw [map_sub, mulLinear_apply, mulLinear_apply]
      _ = 0 := by rw [hen, hev]; simp
  have hfe : c.mul f e = 0 := by
    calc
      c.mul f e = c.mul (n - v) e := by rfl
      _ = c.mul n e - c.mul v e := by
        change (mulLinear c (n - v)) e = _
        rw [(mulLinear c).map_sub, LinearMap.sub_apply,
          mulLinear_apply, mulLinear_apply]
      _ = 0 := by rw [hne, hve]; simp
  have hff : c.mul f f = 0 := by
    calc
      c.mul f f = c.mul ((1 : K) • n + (-1 : K) • v)
          ((1 : K) • n + (-1 : K) • v) := by simp [f, sub_eq_add_neg]
      _ = ((1 : K) * 1) • c.mul n n +
            ((1 : K) * (-1)) • c.mul n v +
              ((-1 : K) * 1) • c.mul v n +
                ((-1 : K) * (-1)) • c.mul v v :=
        mul_linearCombination_pair_three c n v 1 (-1) 1 (-1)
      _ = 0 := by rw [hnn, hnv, hvn, hvv]; simp
  have hfv : c.mul f v = 0 := by
    calc
      c.mul f v = c.mul (n - v) v := by rfl
      _ = c.mul n v - c.mul v v := by
        change (mulLinear c (n - v)) v = _
        rw [(mulLinear c).map_sub, LinearMap.sub_apply,
          mulLinear_apply, mulLinear_apply]
      _ = 0 := by rw [hnv, hvv]; simp
  have hvf : c.mul v f = e := by
    calc
      c.mul v f = c.mul v (n - v) := by rfl
      _ = c.mul v n - c.mul v v := by
        change (mulLinear c v) (n - v) = _
        rw [map_sub, mulLinear_apply, mulLinear_apply]
      _ = e := by rw [hvn, hvv]; simp
  let E := basisEquivOfTripleIndependent hlin'
  let T : TableEquiv (fixedTable (K := K) .w2) c :=
    TableEquiv.ofBasis E (by
      intro i j
      fin_cases i <;> fin_cases j <;>
        simp [fixedTable, E, hee, hef, hev, hfe, hff, hfv,
          hve, hvf, hvv])
  exact ⟨T.symm⟩

/-- A common signed presentation for the complex waved family and its extra
real form. -/
def signedWavedTable (sigma k : K) : StructureConstants K 3 :=
  tableOfProducts 0 0 0 0 e0 0 0 (k • e0) (sigma • e0)

@[simp] theorem signedWavedTable_one (k : K) :
    signedWavedTable (1 : K) k = wavedTable k := by
  simp [signedWavedTable, wavedTable]

@[simp] theorem signedWavedTable_neg_one (k : K) :
    signedWavedTable (-1 : K) k = realWavedMinusTable k := by
  simp [signedWavedTable, realWavedMinusTable]

theorem isomorphic_signedWaved_of_nilpotentChain_normal
    {c : StructureConstants K 3} {e n u : V K} {k q sigma s : K}
    (hlin : TripleIndependent e n u)
    (hnil : IsNilpotentChainPair c e n)
    (heu : c.mul e u = 0) (hue : c.mul u e = 0)
    (hnu : c.mul n u = 0) (hun : c.mul u n = k • e)
    (huu : c.mul u u = q • e)
    (hs : s ≠ 0) (hq : q = s * s * sigma) :
    Isomorphic c (signedWavedTable sigma (s⁻¹ * k)) := by
  rcases hnil with ⟨hee, hen, hne, hnn⟩
  let v : V K := s⁻¹ • u
  have hsinv : s⁻¹ ≠ 0 := inv_ne_zero hs
  have hlinv : TripleIndependent e n v := by
    simpa [v] using
      tripleIndependent_replace_third hlin 0 0 s⁻¹ hsinv
  have hev : c.mul e v = 0 := by
    calc
      c.mul e v = (1 * s⁻¹) • c.mul e u := by
        simpa [v] using mul_smul_smul_three c 1 s⁻¹ e u
      _ = 0 := by rw [heu]; simp
  have hve : c.mul v e = 0 := by
    calc
      c.mul v e = (s⁻¹ * 1) • c.mul u e := by
        simpa [v] using mul_smul_smul_three c s⁻¹ 1 u e
      _ = 0 := by rw [hue]; simp
  have hnv : c.mul n v = 0 := by
    calc
      c.mul n v = (1 * s⁻¹) • c.mul n u := by
        simpa [v] using mul_smul_smul_three c 1 s⁻¹ n u
      _ = 0 := by rw [hnu]; simp
  have hvn : c.mul v n = (s⁻¹ * k) • e := by
    calc
      c.mul v n = (s⁻¹ * 1) • c.mul u n := by
        simpa [v] using mul_smul_smul_three c s⁻¹ 1 u n
      _ = (s⁻¹ * k) • e := by rw [hun]; simp [smul_smul]
  have hvv : c.mul v v = sigma • e := by
    calc
      c.mul v v = (s⁻¹ * s⁻¹) • c.mul u u := by
        simpa [v] using mul_smul_smul_three c s⁻¹ s⁻¹ u u
      _ = sigma • e := by
        rw [huu, hq]
        apply funext_three <;> simp [smul_smul] <;> field_simp [hs] <;> ring
  let E := basisEquivOfTripleIndependent hlinv
  let T : TableEquiv (signedWavedTable sigma (s⁻¹ * k)) c :=
    TableEquiv.ofBasis E (by
      intro i j
      fin_cases i <;> fin_cases j <;>
        simp [signedWavedTable, E, hee, hen, hev, hne, hnn, hnv,
          hve, hvn, hvv])
  exact ⟨T.symm⟩

theorem isomorphic_wavedTable_of_nilpotentChain_normal
    {c : StructureConstants K 3} {e n u : V K} {k q s : K}
    (hlin : TripleIndependent e n u)
    (hnil : IsNilpotentChainPair c e n)
    (heu : c.mul e u = 0) (hue : c.mul u e = 0)
    (hnu : c.mul n u = 0) (hun : c.mul u n = k • e)
    (huu : c.mul u u = q • e)
    (hs : s ≠ 0) (hq : q = s * s) :
    Isomorphic c (wavedTable (s⁻¹ * k)) := by
  simpa using isomorphic_signedWaved_of_nilpotentChain_normal
    (sigma := (1 : K)) hlin hnil heu hue hnu hun huu hs
      (by simpa using hq)

theorem isomorphic_realWavedMinusTable_of_nilpotentChain_normal
    {c : StructureConstants K 3} {e n u : V K} {k q s : K}
    (hlin : TripleIndependent e n u)
    (hnil : IsNilpotentChainPair c e n)
    (heu : c.mul e u = 0) (hue : c.mul u e = 0)
    (hnu : c.mul n u = 0) (hun : c.mul u n = k • e)
    (huu : c.mul u u = q • e)
    (hs : s ≠ 0) (hq : q = -(s * s)) :
    Isomorphic c (realWavedMinusTable (s⁻¹ * k)) := by
  simpa using isomorphic_signedWaved_of_nilpotentChain_normal
    (sigma := (-1 : K)) hlin hnil heu hue hnu hun huu hs
      (by simpa using hq)

/-- Complete complex classification of the waved branch containing a
nilpotent-chain plane. -/
theorem complex_waved_nilpotentChain_classification
    (c : StructureConstants ℂ 3) (ha : c.MultiplicationAssociative)
    (hnonunit : ¬ HasTwoSidedIdentity c)
    (hnotstraight : ¬ IsStraight c)
    {e n g : V ℂ} (hlin : TripleIndependent e n g)
    (hnil : IsNilpotentChainPair c e n) :
    Isomorphic c (fixedTable .w1) ∨
      Isomorphic c (fixedTable .w2) ∨
      ∃ k : ℂ, Isomorphic c (wavedTable k) := by
  obtain ⟨u, k, q, hlinu, heu, hue, hnu, hun, huu⟩ :=
    nonunital_waved_nilpotentChain_normal_form ha hnonunit hnotstraight
      hlin hnil
  by_cases hq0 : q = 0
  · by_cases hk0 : k = 0
    · left
      exact isomorphic_w1_of_nilpotentChain_normal_zero hlinu hnil
        heu hue hnu (by simpa [hk0] using hun) (by simpa [hq0] using huu)
    · right
      left
      exact isomorphic_w2_of_nilpotentChain_normal hlinu hnil heu hue hnu hun
        (by simpa [hq0] using huu) hk0
  · right
    right
    obtain ⟨s, hsquare⟩ := IsAlgClosed.exists_eq_mul_self q
    have hs : s ≠ 0 := by
      intro hs0
      apply hq0
      simpa [hs0] using hsquare
    exact ⟨s⁻¹ * k,
      isomorphic_wavedTable_of_nilpotentChain_normal hlinu hnil
        heu hue hnu hun huu hs (by simpa using hsquare)⟩

/-- Complete real classification of the waved branch containing a
nilpotent-chain plane. -/
theorem real_waved_nilpotentChain_classification
    (c : StructureConstants ℝ 3) (ha : c.MultiplicationAssociative)
    (hnonunit : ¬ HasTwoSidedIdentity c)
    (hnotstraight : ¬ IsStraight c)
    {e n g : V ℝ} (hlin : TripleIndependent e n g)
    (hnil : IsNilpotentChainPair c e n) :
    Isomorphic c (fixedTable .w1) ∨
      Isomorphic c (fixedTable .w2) ∨
      (∃ k : ℝ, Isomorphic c (wavedTable k)) ∨
      ∃ k : ℝ, Isomorphic c (realWavedMinusTable k) := by
  obtain ⟨u, k, q, hlinu, heu, hue, hnu, hun, huu⟩ :=
    nonunital_waved_nilpotentChain_normal_form ha hnonunit hnotstraight
      hlin hnil
  rcases lt_trichotomy q 0 with hqneg | hqzero | hqpos
  · right
    right
    right
    let s : ℝ := Real.sqrt (-q)
    have hspos : 0 < s := Real.sqrt_pos.2 (neg_pos.mpr hqneg)
    have hs : s ≠ 0 := ne_of_gt hspos
    have hsquare : s * s = -q := by
      simpa [s, pow_two] using Real.sq_sqrt (le_of_lt (neg_pos.mpr hqneg))
    refine ⟨s⁻¹ * k,
      isomorphic_realWavedMinusTable_of_nilpotentChain_normal hlinu hnil
        heu hue hnu hun huu hs ?_⟩
    nlinarith
  · by_cases hk0 : k = 0
    · left
      exact isomorphic_w1_of_nilpotentChain_normal_zero hlinu hnil
        heu hue hnu (by simpa [hk0] using hun) (by simpa [hqzero] using huu)
    · right
      left
      exact isomorphic_w2_of_nilpotentChain_normal hlinu hnil heu hue hnu hun
        (by simpa [hqzero] using huu) hk0
  · right
    right
    left
    let s : ℝ := Real.sqrt q
    have hspos : 0 < s := Real.sqrt_pos.2 hqpos
    have hs : s ≠ 0 := ne_of_gt hspos
    have hsquare : s * s = q := by
      simpa [s, pow_two] using Real.sq_sqrt (le_of_lt hqpos)
    exact ⟨s⁻¹ * k,
      isomorphic_wavedTable_of_nilpotentChain_normal hlinu hnil
        heu hue hnu hun huu hs hsquare.symm⟩

/-! ## Peirce reduction around an idempotent-annihilator plane -/

/-- The four simultaneous Peirce projections associated to an idempotent. -/
def peirce00 (c : StructureConstants K 3) (e x : V K) : V K :=
  x - c.mul e x - c.mul x e + c.mul e (c.mul x e)

def peirce01 (c : StructureConstants K 3) (e x : V K) : V K :=
  c.mul x e - c.mul e (c.mul x e)

def peirce10 (c : StructureConstants K 3) (e x : V K) : V K :=
  c.mul e x - c.mul e (c.mul x e)

def peirce11 (c : StructureConstants K 3) (e x : V K) : V K :=
  c.mul e (c.mul x e)

theorem peirce00_relations
    {c : StructureConstants K 3} (ha : c.MultiplicationAssociative)
    {e x : V K} (hee : c.mul e e = e) :
    c.mul e (peirce00 c e x) = 0 ∧
      c.mul (peirce00 c e x) e = 0 := by
  have hLeft (y : V K) : c.mul e (c.mul e y) = c.mul e y := by
    calc
      c.mul e (c.mul e y) = c.mul (c.mul e e) y := (ha e e y).symm
      _ = c.mul e y := by rw [hee]
  have hRight (y : V K) : c.mul (c.mul y e) e = c.mul y e := by
    calc
      c.mul (c.mul y e) e = c.mul y (c.mul e e) := ha y e e
      _ = c.mul y e := by rw [hee]
  have hComm : c.mul (c.mul e x) e = c.mul e (c.mul x e) := ha e x e
  have hCrossRight :
      c.mul (c.mul e (c.mul x e)) e = c.mul e (c.mul x e) := by
    calc
      c.mul (c.mul e (c.mul x e)) e =
          c.mul e (c.mul (c.mul x e) e) := ha e (c.mul x e) e
      _ = c.mul e (c.mul x e) := by rw [hRight x]
  constructor
  · rw [peirce00]
    change (mulLinear c e)
      (x - c.mul e x - c.mul x e + c.mul e (c.mul x e)) = 0
    rw [map_add, map_sub, map_sub, mulLinear_apply, mulLinear_apply,
      mulLinear_apply, mulLinear_apply, hLeft, hLeft]
    abel
  · rw [peirce00]
    change (mulLinear c
      (x - c.mul e x - c.mul x e + c.mul e (c.mul x e))) e = 0
    rw [(mulLinear c).map_add, (mulLinear c).map_sub,
      (mulLinear c).map_sub, LinearMap.add_apply, LinearMap.sub_apply,
      LinearMap.sub_apply, mulLinear_apply, mulLinear_apply, mulLinear_apply,
      mulLinear_apply, hRight x, hComm, hCrossRight]
    abel

theorem peirce01_relations
    {c : StructureConstants K 3} (ha : c.MultiplicationAssociative)
    {e x : V K} (hee : c.mul e e = e) :
    c.mul e (peirce01 c e x) = 0 ∧
      c.mul (peirce01 c e x) e = peirce01 c e x := by
  have hLeft (y : V K) : c.mul e (c.mul e y) = c.mul e y := by
    calc
      c.mul e (c.mul e y) = c.mul (c.mul e e) y := (ha e e y).symm
      _ = c.mul e y := by rw [hee]
  have hRight (y : V K) : c.mul (c.mul y e) e = c.mul y e := by
    calc
      c.mul (c.mul y e) e = c.mul y (c.mul e e) := ha y e e
      _ = c.mul y e := by rw [hee]
  have hCrossRight :
      c.mul (c.mul e (c.mul x e)) e = c.mul e (c.mul x e) := by
    calc
      c.mul (c.mul e (c.mul x e)) e =
          c.mul e (c.mul (c.mul x e) e) := ha e (c.mul x e) e
      _ = c.mul e (c.mul x e) := by rw [hRight x]
  constructor
  · rw [peirce01]
    change (mulLinear c e) (c.mul x e - c.mul e (c.mul x e)) = 0
    rw [map_sub, mulLinear_apply, mulLinear_apply, hLeft]
    simp
  · rw [peirce01]
    change (mulLinear c (c.mul x e - c.mul e (c.mul x e))) e = _
    rw [(mulLinear c).map_sub, LinearMap.sub_apply, mulLinear_apply,
      mulLinear_apply, hRight x, hCrossRight]

theorem peirce10_relations
    {c : StructureConstants K 3} (ha : c.MultiplicationAssociative)
    {e x : V K} (hee : c.mul e e = e) :
    c.mul e (peirce10 c e x) = peirce10 c e x ∧
      c.mul (peirce10 c e x) e = 0 := by
  have hLeft (y : V K) : c.mul e (c.mul e y) = c.mul e y := by
    calc
      c.mul e (c.mul e y) = c.mul (c.mul e e) y := (ha e e y).symm
      _ = c.mul e y := by rw [hee]
  have hComm : c.mul (c.mul e x) e = c.mul e (c.mul x e) := ha e x e
  have hRight (y : V K) : c.mul (c.mul y e) e = c.mul y e := by
    calc
      c.mul (c.mul y e) e = c.mul y (c.mul e e) := ha y e e
      _ = c.mul y e := by rw [hee]
  have hCrossRight :
      c.mul (c.mul e (c.mul x e)) e = c.mul e (c.mul x e) := by
    calc
      c.mul (c.mul e (c.mul x e)) e =
          c.mul e (c.mul (c.mul x e) e) := ha e (c.mul x e) e
      _ = c.mul e (c.mul x e) := by rw [hRight x]
  constructor
  · rw [peirce10]
    change (mulLinear c e) (c.mul e x - c.mul e (c.mul x e)) = _
    rw [map_sub, mulLinear_apply, mulLinear_apply, hLeft, hLeft]
  · rw [peirce10]
    change (mulLinear c (c.mul e x - c.mul e (c.mul x e))) e = 0
    rw [(mulLinear c).map_sub, LinearMap.sub_apply, mulLinear_apply,
      mulLinear_apply, hComm, hCrossRight]
    simp

theorem peirce11_relations
    {c : StructureConstants K 3} (ha : c.MultiplicationAssociative)
    {e x : V K} (hee : c.mul e e = e) :
    c.mul e (peirce11 c e x) = peirce11 c e x ∧
      c.mul (peirce11 c e x) e = peirce11 c e x := by
  have hLeft (y : V K) : c.mul e (c.mul e y) = c.mul e y := by
    calc
      c.mul e (c.mul e y) = c.mul (c.mul e e) y := (ha e e y).symm
      _ = c.mul e y := by rw [hee]
  have hRight (y : V K) : c.mul (c.mul y e) e = c.mul y e := by
    calc
      c.mul (c.mul y e) e = c.mul y (c.mul e e) := ha y e e
      _ = c.mul y e := by rw [hee]
  have hCrossRight :
      c.mul (c.mul e (c.mul x e)) e = c.mul e (c.mul x e) := by
    calc
      c.mul (c.mul e (c.mul x e)) e =
          c.mul e (c.mul (c.mul x e) e) := ha e (c.mul x e) e
      _ = c.mul e (c.mul x e) := by rw [hRight x]
  constructor
  · exact hLeft (c.mul x e)
  · rw [peirce11]
    exact hCrossRight

/-- A basis containing an idempotent and a vector annihilated by it can be
refined so that the third vector lies in one of the four Peirce components. -/
theorem exists_peirce_basis_of_idempotentAnnihilator
    {c : StructureConstants K 3} (ha : c.MultiplicationAssociative)
    {e n g : V K} (hlin : TripleIndependent e n g)
    (hpair : IsIdempotentAnnihilatorPair c e n) :
    ∃ u : V K, TripleIndependent e n u ∧
      ((c.mul e u = 0 ∧ c.mul u e = 0) ∨
        (c.mul e u = 0 ∧ c.mul u e = u) ∨
        (c.mul e u = u ∧ c.mul u e = 0) ∨
        (c.mul e u = u ∧ c.mul u e = u)) := by
  rcases hpair with ⟨hee, hen, hne, _hnn⟩
  obtain ⟨a0, a1, a2, heg⟩ :=
    exists_three_coefficients (c.mul e g) hlin
  obtain ⟨b0, b1, b2, hge⟩ :=
    exists_three_coefficients (c.mul g e) hlin
  have hLeg : c.mul e (c.mul e g) = c.mul e g := by
    calc
      c.mul e (c.mul e g) = c.mul (c.mul e e) g := (ha e e g).symm
      _ = c.mul e g := by rw [hee]
  have hLegExpansion : c.mul e (c.mul e g) =
      (a0 + a2 * a0) • e + (a2 * a1) • n + (a2 * a2) • g := by
    rw [heg]
    change (mulLinear c e) (a0 • e + a1 • n + a2 • g) = _
    rw [map_add, map_add, map_smul, map_smul, map_smul,
      mulLinear_apply, mulLinear_apply, mulLinear_apply, hee, hen, heg]
    apply funext_three <;> simp [smul_add, smul_smul] <;> ring
  have hLeftCoeffs :=
    (tripleIndependent_smul_add_smul_add_smul_iff hlin
      (a0 + a2 * a0) (a2 * a1) (a2 * a2) a0 a1 a2).mp
      (hLegExpansion.symm.trans (hLeg.trans heg))
  have ha2idem : a2 * a2 = a2 := hLeftCoeffs.2.2
  have ha2cases : a2 = 0 ∨ a2 = 1 := by
    have hprod : a2 * (a2 - 1) = 0 := by linear_combination ha2idem
    rcases mul_eq_zero.mp hprod with h | h
    · exact Or.inl h
    · exact Or.inr (sub_eq_zero.mp h)
  have hgeR : c.mul (c.mul g e) e = c.mul g e := by
    calc
      c.mul (c.mul g e) e = c.mul g (c.mul e e) := ha g e e
      _ = c.mul g e := by rw [hee]
  have hgeRExpansion : c.mul (c.mul g e) e =
      (b0 + b2 * b0) • e + (b2 * b1) • n + (b2 * b2) • g := by
    rw [hge]
    change (mulLinear c (b0 • e + b1 • n + b2 • g)) e = _
    rw [(mulLinear c).map_add, (mulLinear c).map_add,
      (mulLinear c).map_smul, (mulLinear c).map_smul,
      (mulLinear c).map_smul, LinearMap.add_apply, LinearMap.add_apply,
      LinearMap.smul_apply, LinearMap.smul_apply, LinearMap.smul_apply,
      mulLinear_apply, mulLinear_apply, mulLinear_apply, hee, hne, hge]
    apply funext_three <;> simp [smul_add, smul_smul] <;> ring
  have hRightCoeffs :=
    (tripleIndependent_smul_add_smul_add_smul_iff hlin
      (b0 + b2 * b0) (b2 * b1) (b2 * b2) b0 b1 b2).mp
      (hgeRExpansion.symm.trans (hgeR.trans hge))
  have hb2idem : b2 * b2 = b2 := hRightCoeffs.2.2
  have hb2cases : b2 = 0 ∨ b2 = 1 := by
    have hprod : b2 * (b2 - 1) = 0 := by linear_combination hb2idem
    rcases mul_eq_zero.mp hprod with h | h
    · exact Or.inl h
    · exact Or.inr (sub_eq_zero.mp h)
  have hcrossExpansion : c.mul e (c.mul g e) =
      (b0 + b2 * a0) • e + (b2 * a1) • n + (b2 * a2) • g := by
    rw [hge]
    change (mulLinear c e) (b0 • e + b1 • n + b2 • g) = _
    rw [map_add, map_add, map_smul, map_smul, map_smul,
      mulLinear_apply, mulLinear_apply, mulLinear_apply, hee, hen, heg]
    apply funext_three <;> simp [smul_add, smul_smul] <;> ring
  rcases ha2cases with ha20 | ha21 <;> rcases hb2cases with hb20 | hb21
  · let u := peirce00 c e g
    have huRep : u =
        (-a0 + b2 * a0) • e + (-a1 - b1 + b2 * a1) • n + (1 : K) • g := by
      rw [show u = g - c.mul e g - c.mul g e +
          c.mul e (c.mul g e) by rfl, hcrossExpansion, heg, hge]
      apply funext_three <;>
        simp [ha20, hb20, smul_add, smul_smul] <;> ring
    have hlinu : TripleIndependent e n u := by
      rw [huRep]
      exact tripleIndependent_replace_third hlin
        (-a0 + b2 * a0) (-a1 - b1 + b2 * a1) 1 one_ne_zero
    exact ⟨u, hlinu, Or.inl (peirce00_relations ha hee)⟩
  · let u := peirce01 c e g
    have huRep : u =
        (-b2 * a0) • e + (b1 - b2 * a1) • n + (1 : K) • g := by
      rw [show u = c.mul g e - c.mul e (c.mul g e) by rfl,
        hcrossExpansion, hge]
      apply funext_three <;>
        simp [ha20, hb21, smul_add, smul_smul] <;> ring
    have hlinu : TripleIndependent e n u := by
      rw [huRep]
      exact tripleIndependent_replace_third hlin
        (-b2 * a0) (b1 - b2 * a1) 1 one_ne_zero
    exact ⟨u, hlinu, Or.inr (Or.inl (peirce01_relations ha hee))⟩
  · let u := peirce10 c e g
    have huRep : u =
        (a0 - b0 - b2 * a0) • e + (a1 - b2 * a1) • n + (1 : K) • g := by
      rw [show u = c.mul e g - c.mul e (c.mul g e) by rfl,
        hcrossExpansion, heg]
      apply funext_three <;>
        simp [ha21, hb20, smul_add, smul_smul] <;> ring
    have hlinu : TripleIndependent e n u := by
      rw [huRep]
      exact tripleIndependent_replace_third hlin
        (a0 - b0 - b2 * a0) (a1 - b2 * a1) 1 one_ne_zero
    exact ⟨u, hlinu, Or.inr (Or.inr (Or.inl (peirce10_relations ha hee)))⟩
  · let u := peirce11 c e g
    have huRep : u =
        (b0 + b2 * a0) • e + (b2 * a1) • n + (1 : K) • g := by
      rw [show u = c.mul e (c.mul g e) by rfl, hcrossExpansion]
      apply funext_three <;>
        simp [ha21, hb21, smul_add, smul_smul] <;> ring
    have hlinu : TripleIndependent e n u := by
      rw [huRep]
      exact tripleIndependent_replace_third hlin
        (b0 + b2 * a0) (b2 * a1) 1 one_ne_zero
    exact ⟨u, hlinu, Or.inr (Or.inr (Or.inr (peirce11_relations ha hee)))⟩

theorem isomorphic_w6_of_peirce01_basis
    {c : StructureConstants K 3} (ha : c.MultiplicationAssociative)
    {e n u : V K} (hlin : TripleIndependent e n u)
    (hpair : IsIdempotentAnnihilatorPair c e n)
    (heu : c.mul e u = 0) (hue : c.mul u e = u) :
    Isomorphic c (fixedTable .w6) := by
  rcases hpair with ⟨hee, hen, hne, hnn⟩
  obtain ⟨a, b, d, hnuRep⟩ :=
    exists_three_coefficients (c.mul n u) hlin
  have hLeft : c.mul e (c.mul n u) = 0 := by
    calc
      c.mul e (c.mul n u) = c.mul (c.mul e n) u := (ha e n u).symm
      _ = 0 := by rw [hen]; simp [← mulLinear_apply]
  have hLeftExpansion : c.mul e (c.mul n u) = a • e := by
    rw [hnuRep]
    change (mulLinear c e) (a • e + b • n + d • u) = a • e
    rw [map_add, map_add, map_smul, map_smul, map_smul,
      mulLinear_apply, mulLinear_apply, mulLinear_apply, hee, hen, heu]
    simp
  have ha0 : a = 0 := by
    have hv : a • e + (0 : K) • n + (0 : K) • u =
        (0 : K) • e + (0 : K) • n + (0 : K) • u := by
      simpa [hLeftExpansion] using hLeft
    exact (tripleIndependent_smul_add_smul_add_smul_iff hlin
      a 0 0 0 0 0).mp hv |>.1
  have hRight : c.mul (c.mul n u) e = c.mul n u := by
    calc
      c.mul (c.mul n u) e = c.mul n (c.mul u e) := ha n u e
      _ = c.mul n u := by rw [hue]
  have hRightExpansion : c.mul (c.mul n u) e = d • u := by
    rw [hnuRep]
    change (mulLinear c (a • e + b • n + d • u)) e = d • u
    rw [(mulLinear c).map_add, (mulLinear c).map_add,
      (mulLinear c).map_smul, (mulLinear c).map_smul,
      (mulLinear c).map_smul, LinearMap.add_apply, LinearMap.add_apply,
      LinearMap.smul_apply, LinearMap.smul_apply, LinearMap.smul_apply,
      mulLinear_apply, mulLinear_apply, mulLinear_apply, hee, hne, hue, ha0]
    simp
  have hb0 : b = 0 := by
    have hdu : d • u = a • e + b • n + d • u :=
      hRightExpansion.symm.trans (hRight.trans hnuRep)
    have hv : (0 : K) • e + (0 : K) • n + d • u =
        a • e + b • n + d • u := by
      simpa using hdu
    have hc := (tripleIndependent_smul_add_smul_add_smul_iff hlin
      0 0 d a b d).mp hv
    exact hc.2.1.symm
  have hnu' : c.mul n u = d • u := by simpa [ha0, hb0] using hnuRep
  have hzero : c.mul n (c.mul n u) = 0 := by
    calc
      c.mul n (c.mul n u) = c.mul (c.mul n n) u := (ha n n u).symm
      _ = 0 := by rw [hnn]; simp [← mulLinear_apply]
  have hdsq : d * d = 0 := by
    have hexp : c.mul n (c.mul n u) = (d * d) • u := by
      rw [hnu']
      change (mulLinear c n) (d • u) = _
      rw [map_smul, mulLinear_apply, hnu', smul_smul]
    have hv : (0 : K) • e + (0 : K) • n + (d * d) • u =
        (0 : K) • e + (0 : K) • n + (0 : K) • u := by
      simpa [hexp] using hzero
    exact (tripleIndependent_smul_add_smul_add_smul_iff hlin
      0 0 (d * d) 0 0 0).mp hv |>.2.2
  have hd0 : d = 0 := by
    rcases mul_eq_zero.mp hdsq with hd | hd <;> exact hd
  have hnu : c.mul n u = 0 := by simpa [hd0] using hnu'
  have hun : c.mul u n = 0 := by
    calc
      c.mul u n = c.mul (c.mul u e) n := by rw [hue]
      _ = c.mul u (c.mul e n) := ha u e n
      _ = 0 := by rw [hen]; simp [← mulLinear_apply]
  have huu : c.mul u u = 0 := by
    calc
      c.mul u u = c.mul (c.mul u e) u := by rw [hue]
      _ = c.mul u (c.mul e u) := ha u e u
      _ = 0 := by rw [heu]; simp [← mulLinear_apply]
  have hlin' : TripleIndependent n u e := tripleIndependent_cycle hlin
  let E := basisEquivOfTripleIndependent hlin'
  let T : TableEquiv (fixedTable (K := K) .w6) c :=
    TableEquiv.ofBasis E (by
      intro i j
      fin_cases i <;> fin_cases j <;>
        simp [fixedTable, E, hnn, hnu, hne, hun, huu, hue,
          hen, heu, hee])
  exact ⟨T.symm⟩

theorem isomorphic_w5_of_peirce10_basis
    {c : StructureConstants K 3} (ha : c.MultiplicationAssociative)
    {e n u : V K} (hlin : TripleIndependent e n u)
    (hpair : IsIdempotentAnnihilatorPair c e n)
    (heu : c.mul e u = u) (hue : c.mul u e = 0) :
    Isomorphic c (fixedTable .w5) := by
  have hop : IsIdempotentAnnihilatorPair c e n := hpair
  rcases hpair with ⟨hee, hen, hne, hnn⟩
  obtain ⟨a, b, d, hunRep⟩ :=
    exists_three_coefficients (c.mul u n) hlin
  have hRight : c.mul (c.mul u n) e = 0 := by
    calc
      c.mul (c.mul u n) e = c.mul u (c.mul n e) := ha u n e
      _ = 0 := by rw [hne]; simp [← mulLinear_apply]
  have hRightExpansion : c.mul (c.mul u n) e = a • e := by
    rw [hunRep]
    change (mulLinear c (a • e + b • n + d • u)) e = a • e
    rw [(mulLinear c).map_add, (mulLinear c).map_add,
      (mulLinear c).map_smul, (mulLinear c).map_smul,
      (mulLinear c).map_smul, LinearMap.add_apply, LinearMap.add_apply,
      LinearMap.smul_apply, LinearMap.smul_apply, LinearMap.smul_apply,
      mulLinear_apply, mulLinear_apply, mulLinear_apply, hee, hne, hue]
    simp
  have ha0 : a = 0 := by
    have hv : a • e + (0 : K) • n + (0 : K) • u =
        (0 : K) • e + (0 : K) • n + (0 : K) • u := by
      simpa [hRightExpansion] using hRight
    exact (tripleIndependent_smul_add_smul_add_smul_iff hlin
      a 0 0 0 0 0).mp hv |>.1
  have hLeft : c.mul e (c.mul u n) = c.mul u n := by
    calc
      c.mul e (c.mul u n) = c.mul (c.mul e u) n := (ha e u n).symm
      _ = c.mul u n := by rw [heu]
  have hLeftExpansion : c.mul e (c.mul u n) = d • u := by
    rw [hunRep]
    change (mulLinear c e) (a • e + b • n + d • u) = d • u
    rw [map_add, map_add, map_smul, map_smul, map_smul,
      mulLinear_apply, mulLinear_apply, mulLinear_apply, hee, hen, heu, ha0]
    simp
  have hb0 : b = 0 := by
    have hdu : d • u = a • e + b • n + d • u :=
      hLeftExpansion.symm.trans (hLeft.trans hunRep)
    have hv : (0 : K) • e + (0 : K) • n + d • u =
        a • e + b • n + d • u := by
      simpa using hdu
    have hc := (tripleIndependent_smul_add_smul_add_smul_iff hlin
      0 0 d a b d).mp hv
    exact hc.2.1.symm
  have hun' : c.mul u n = d • u := by simpa [ha0, hb0] using hunRep
  have hzero : c.mul (c.mul u n) n = 0 := by
    calc
      c.mul (c.mul u n) n = c.mul u (c.mul n n) := ha u n n
      _ = 0 := by rw [hnn]; simp [← mulLinear_apply]
  have hdsq : d * d = 0 := by
    have hexp : c.mul (c.mul u n) n = (d * d) • u := by
      rw [hun']
      change (mulLinear c (d • u)) n = _
      rw [(mulLinear c).map_smul, LinearMap.smul_apply,
        mulLinear_apply, hun', smul_smul]
    have hv : (0 : K) • e + (0 : K) • n + (d * d) • u =
        (0 : K) • e + (0 : K) • n + (0 : K) • u := by
      simpa [hexp] using hzero
    exact (tripleIndependent_smul_add_smul_add_smul_iff hlin
      0 0 (d * d) 0 0 0).mp hv |>.2.2
  have hd0 : d = 0 := by
    rcases mul_eq_zero.mp hdsq with hd | hd <;> exact hd
  have hun : c.mul u n = 0 := by simpa [hd0] using hun'
  have hnu : c.mul n u = 0 := by
    calc
      c.mul n u = c.mul n (c.mul e u) := by rw [heu]
      _ = c.mul (c.mul n e) u := (ha n e u).symm
      _ = 0 := by rw [hne]; simp [← mulLinear_apply]
  have huu : c.mul u u = 0 := by
    calc
      c.mul u u = c.mul u (c.mul e u) := by rw [heu]
      _ = c.mul (c.mul u e) u := (ha u e u).symm
      _ = 0 := by rw [hue]; simp [← mulLinear_apply]
  have hlin' : TripleIndependent n u e := tripleIndependent_cycle hlin
  let E := basisEquivOfTripleIndependent hlin'
  let T : TableEquiv (fixedTable (K := K) .w5) c :=
    TableEquiv.ofBasis E (by
      intro i j
      fin_cases i <;> fin_cases j <;>
        simp [fixedTable, E, hnn, hnu, hne, hun, huu, hue,
          hen, heu, hee])
  exact ⟨T.symm⟩

/-- Negating scalar-square existence is exactly the independence condition
needed for a nonzero element and its square. -/
theorem pairIndependent_square_of_not_hasScalarSquare
    {c : StructureConstants K 3} {x : V K}
    (h : ¬ HasScalarSquare c x) : PairIndependent x (c.mul x x) := by
  constructor
  · intro hx
    apply h
    refine ⟨0, ?_⟩
    subst x
    simp [← mulLinear_apply]
  · intro a ha
    exact h ⟨a, ha⟩

/-- An idempotent direction together with an independent pair that it
annihilates is an independent triple. -/
theorem tripleIndependent_idempotent_and_pair
    {c : StructureConstants K 3} {e x y : V K}
    (he0 : e ≠ 0) (hee : c.mul e e = e) (hex : c.mul e x = 0)
    (hey : c.mul e y = 0) (hxy : PairIndependent x y) :
    TripleIndependent e x y := by
  rw [TripleIndependent, Fintype.linearIndependent_iff]
  intro q hrel
  have hrel' : q 0 • e + q 1 • x + q 2 • y = 0 := by
    simpa [Fin.sum_univ_three] using hrel
  have hmul := congrArg (fun v => c.mul e v) hrel'
  have hq0e : q 0 • e = 0 := by
    rw [mul_second_linearCombination_three, hee, hex, hey] at hmul
    simpa [← mulLinear_apply] using hmul
  have hq0 : q 0 = 0 := (smul_eq_zero.mp hq0e).resolve_right he0
  have hrest : q 1 • x + q 2 • y = (0 : K) • x + (0 : K) • y := by
    simpa [hq0] using hrel'
  have hc := (pairIndependent_smul_add_eq_smul_add_iff hxy
    (q 1) (q 2) 0 0).mp hrest
  intro i
  fin_cases i
  · exact hq0
  · exact hc.1
  · exact hc.2

/-- Over characteristic zero, one of `1,2,3` avoids the two roots of a given
quadratic. -/
theorem exists_nonzero_quadratic_avoidance [CharZero K] (a b : K) :
    ∃ t : K, t ≠ 0 ∧ t * t - b * t - a ≠ 0 := by
  by_cases h1 : (1 : K) * 1 - b * 1 - a = 0
  · by_cases h2 : (2 : K) * 2 - b * 2 - a = 0
    · refine ⟨3, by norm_num, ?_⟩
      intro h3
      have hfalse : (2 : K) = 0 := by
        linear_combination h3 - 2 * h2 + h1
      norm_num at hfalse
    · exact ⟨2, by norm_num, h2⟩
  · exact ⟨1, one_ne_zero, h1⟩

/-- The determinant calculation behind adjoining an orthogonal idempotent to
a two-dimensional power sequence. -/
theorem tripleIndependent_power_shift
    {e x x2 : V K} (hlin : TripleIndependent e x x2)
    (a b t : K) (ht : t ≠ 0) (hquad : t * t - b * t - a ≠ 0) :
    TripleIndependent (x + t • e) (x2 + (t * t) • e)
      (a • x + b • x2 + (t * t * t) • e) := by
  rw [TripleIndependent, Fintype.linearIndependent_iff] at hlin ⊢
  intro q hrel
  have hrel' :
      q 0 • (x + t • e) + q 1 • (x2 + (t * t) • e) +
          q 2 • (a • x + b • x2 + (t * t * t) • e) = 0 := by
    simpa [Fin.sum_univ_three] using hrel
  let r : Fin 3 → K :=
    at3 (q 0 * t + q 1 * (t * t) + q 2 * (t * t * t))
      (q 0 + q 2 * a) (q 1 + q 2 * b)
  have hrrel : ∑ i, r i • at3 e x x2 i = 0 := by
    simp [r, Fin.sum_univ_three]
    calc
      (q 0 * t + q 1 * (t * t) + q 2 * (t * t * t)) • e +
            (q 0 + q 2 * a) • x + (q 1 + q 2 * b) • x2 =
          q 0 • (x + t • e) + q 1 • (x2 + (t * t) • e) +
            q 2 • (a • x + b • x2 + (t * t * t) • e) := by
        apply funext_three <;> simp [smul_add, smul_smul] <;> ring
      _ = 0 := hrel'
  have hr0 := hlin r hrrel 0
  have hr1 := hlin r hrrel 1
  have hr2 := hlin r hrrel 2
  have hq2prod : q 2 * (t * (t * t - b * t - a)) = 0 := by
    dsimp [r] at hr0 hr1 hr2
    linear_combination hr0 - t * hr1 - (t * t) * hr2
  have htquad : t * (t * t - b * t - a) ≠ 0 := mul_ne_zero ht hquad
  have hq2 : q 2 = 0 := (mul_eq_zero.mp hq2prod).resolve_right htquad
  have hq0 : q 0 = 0 := by simpa [r, hq2] using hr1
  have hq1 : q 1 = 0 := by simpa [r, hq2] using hr2
  intro i
  fin_cases i
  · exact hq0
  · exact hq1
  · exact hq2

/-- Every vector in the span of the displayed pair has scalar square. -/
def IsCurledOnPairPlane
    (c : StructureConstants K 3) (x y : V K) : Prop :=
  ∀ a b : K, HasScalarSquare c (a • x + b • y)

/-- If the `00` Peirce plane contained a noncurled element, adjoining the
orthogonal idempotent would give a straight generator. -/
theorem peirce00_plane_curled_of_notStraight [CharZero K]
    {c : StructureConstants K 3} (ha : c.MultiplicationAssociative)
    (hnotstraight : ¬ IsStraight c)
    {e n u : V K} (hlin : TripleIndependent e n u)
    (hpair : IsIdempotentAnnihilatorPair c e n)
    (heu : c.mul e u = 0) (hue : c.mul u e = 0) :
    IsCurledOnPairPlane c n u := by
  rcases hpair with ⟨hee, hen, hne, _hnn⟩
  intro alpha beta
  let x : V K := alpha • n + beta • u
  by_contra hxScalar
  have hxxPair : PairIndependent x (c.mul x x) :=
    pairIndependent_square_of_not_hasScalarSquare hxScalar
  have hex : c.mul e x = 0 := by
    change c.mul e (alpha • n + beta • u) = 0
    change (mulLinear c e) (alpha • n + beta • u) = 0
    rw [map_add, map_smul, map_smul, mulLinear_apply, mulLinear_apply,
      hen, heu]
    simp
  have hxe : c.mul x e = 0 := by
    change c.mul (alpha • n + beta • u) e = 0
    change (mulLinear c (alpha • n + beta • u)) e = 0
    rw [(mulLinear c).map_add, (mulLinear c).map_smul,
      (mulLinear c).map_smul, LinearMap.add_apply, LinearMap.smul_apply,
      LinearMap.smul_apply, mulLinear_apply, mulLinear_apply, hne, hue]
    simp
  have hexx : c.mul e (c.mul x x) = 0 := by
    calc
      c.mul e (c.mul x x) = c.mul (c.mul e x) x := (ha e x x).symm
      _ = 0 := by rw [hex]; simp [← mulLinear_apply]
  have hxxe : c.mul (c.mul x x) e = 0 := by
    calc
      c.mul (c.mul x x) e = c.mul x (c.mul x e) := ha x x e
      _ = 0 := by rw [hxe]; simp [← mulLinear_apply]
  have he0 : e ≠ 0 := by
    rw [TripleIndependent] at hlin
    have := hlin.ne_zero 0
    simpa using this
  have hbasis : TripleIndependent e x (c.mul x x) :=
    tripleIndependent_idempotent_and_pair he0 hee hex hexx hxxPair
  let x3 := c.mul (c.mul x x) x
  obtain ⟨r0, a, b, hx3Rep⟩ := exists_three_coefficients x3 hbasis
  have hex3 : c.mul e x3 = 0 := by
    calc
      c.mul e x3 = c.mul e (c.mul (c.mul x x) x) := rfl
      _ = c.mul (c.mul e (c.mul x x)) x := (ha e (c.mul x x) x).symm
      _ = 0 := by rw [hexx]; simp [← mulLinear_apply]
  have hex3Expansion : c.mul e x3 = r0 • e := by
    rw [hx3Rep]
    change (mulLinear c e)
      (r0 • e + a • x + b • c.mul x x) = r0 • e
    rw [map_add, map_add, map_smul, map_smul, map_smul,
      mulLinear_apply, mulLinear_apply, mulLinear_apply, hee, hex, hexx]
    simp
  have hr0 : r0 = 0 := by
    have hv : r0 • e + (0 : K) • x + (0 : K) • c.mul x x =
        (0 : K) • e + (0 : K) • x + (0 : K) • c.mul x x := by
      simpa [hex3Expansion] using hex3
    exact (tripleIndependent_smul_add_smul_add_smul_iff hbasis
      r0 0 0 0 0 0).mp hv |>.1
  have hx3 : x3 = a • x + b • c.mul x x := by
    simpa [hr0] using hx3Rep
  obtain ⟨t, ht, hquad⟩ := exists_nonzero_quadratic_avoidance a b
  let y : V K := x + t • e
  have hyy : c.mul y y = c.mul x x + (t * t) • e := by
    calc
      c.mul y y = c.mul ((1 : K) • x + t • e)
          ((1 : K) • x + t • e) := by simp [y]
      _ = ((1 : K) * 1) • c.mul x x +
            ((1 : K) * t) • c.mul x e +
              (t * 1) • c.mul e x + (t * t) • c.mul e e :=
        mul_linearCombination_pair_three c x e 1 t 1 t
      _ = c.mul x x + (t * t) • e := by rw [hxe, hex, hee]; simp
  have hyyy : c.mul (c.mul y y) y =
      a • x + b • c.mul x x + (t * t * t) • e := by
    rw [hyy]
    calc
      c.mul (c.mul x x + (t * t) • e) y =
          c.mul ((1 : K) • c.mul x x + (t * t) • e)
            ((1 : K) • x + t • e) := by simp [y]
      _ = c.mul (c.mul x x) x + c.mul (c.mul x x) (t • e) +
            c.mul ((t * t) • e) x + c.mul ((t * t) • e) (t • e) := by
        simpa only [one_smul] using
          mul_add_add_three c (c.mul x x) ((t * t) • e) x (t • e)
      _ = a • x + b • c.mul x x + (t * t * t) • e := by
        rw [show c.mul (c.mul x x) x = x3 by rfl, hx3,
          show c.mul (c.mul x x) (t • e) =
              t • c.mul (c.mul x x) e by
            simpa using mul_smul_smul_three c 1 t (c.mul x x) e,
          show c.mul ((t * t) • e) x =
              (t * t) • c.mul e x by
            simpa using mul_smul_smul_three c (t * t) 1 e x,
          show c.mul ((t * t) • e) (t • e) =
              ((t * t) * t) • c.mul e e by
            exact mul_smul_smul_three c (t * t) t e e,
          hxxe, hex, hee]
        apply funext_three <;> simp [smul_add, smul_smul] <;> ring
  apply hnotstraight
  refine ⟨y, ?_⟩
  rw [hyyy, hyy]
  simpa only [y] using
    tripleIndependent_power_shift hbasis a b t ht hquad

/-- Associativity and curledness reduce the multiplication on a two-dimensional
`00` Peirce plane to two scalars. -/

theorem peirce00_curled_plane_parameters [CharZero K]
    {c : StructureConstants K 3} (ha : c.MultiplicationAssociative)
    {e n u : V K} (hlin : TripleIndependent e n u)
    (hpair : IsIdempotentAnnihilatorPair c e n)
    (heu : c.mul e u = 0) (hue : c.mul u e = 0)
    (hcurl : IsCurledOnPairPlane c n u) :
    ∃ a q : K,
      c.mul n u = a • n ∧
      c.mul u n = (q - a) • n ∧
      c.mul u u = q • u ∧
      a * (a - q) = 0 := by
  rcases hpair with ⟨hee, hen, _hne, hnn⟩
  have hnuPair : PairIndependent n u := by
    constructor
    · rw [TripleIndependent] at hlin
      simpa using hlin.ne_zero 1
    · intro a
      exact tripleIndependent_second_not_smul (tripleIndependent_cycle hlin) a
  obtain ⟨q, huuRaw⟩ := hcurl 0 1
  have huu : c.mul u u = q • u := by simpa using huuRaw
  obtain ⟨m, hsumRaw⟩ := hcurl 1 1
  have hsumSquare : c.mul (n + u) (n + u) = m • (n + u) := by
    simpa using hsumRaw
  have hsymM : c.mul n u + c.mul u n =
      m • n + (m - q) • u := by
    have hexpand : c.mul (n + u) (n + u) =
        c.mul n n + c.mul n u + c.mul u n + c.mul u u := by
      simpa using mul_linearCombination_self_three c n u 1 1
    calc
      c.mul n u + c.mul u n =
          (c.mul n n + c.mul n u + c.mul u n + c.mul u u) -
            c.mul n n - c.mul u u := by abel
      _ = c.mul (n + u) (n + u) - c.mul n n - c.mul u u := by rw [hexpand]
      _ = m • (n + u) - q • u := by rw [hsumSquare, hnn, huu]; simp
      _ = m • n + (m - q) • u := by
        apply funext_three <;> simp [smul_add, sub_smul] <;> ring
  obtain ⟨p, htwoRaw⟩ := hcurl 1 2
  have htwoSquare : c.mul (n + (2 : K) • u) (n + (2 : K) • u) =
      p • (n + (2 : K) • u) := by simpa only [one_smul] using htwoRaw
  have htwoLeft : c.mul (n + (2 : K) • u) (n + (2 : K) • u) =
      ((2 : K) * m) • n + ((2 : K) * m + (2 : K) * q) • u := by
    calc
      c.mul (n + (2 : K) • u) (n + (2 : K) • u) =
          ((1 : K) * (1 : K)) • c.mul n n +
            ((1 : K) * (2 : K)) • c.mul n u +
              ((2 : K) * (1 : K)) • c.mul u n +
                ((2 : K) * (2 : K)) • c.mul u u := by
        simpa only [one_smul] using
          mul_linearCombination_self_three c n u (1 : K) (2 : K)
      _ = ((2 : K) * m) • n +
          ((2 : K) * m + (2 : K) * q) • u := by
        rw [hnn, huu]
        calc
          _ = (2 : K) • (c.mul n u + c.mul u n) +
              (4 : K) • (q • u) := by
            module
          _ = (2 : K) • (m • n + (m - q) • u) +
              (4 : K) • (q • u) := by rw [hsymM]
          _ = ((2 : K) * m) • n +
              ((2 : K) * m + (2 : K) * q) • u := by
            module
  have htwoRight : p • (n + (2 : K) • u) =
      p • n + ((2 : K) * p) • u := by
    apply funext_three <;> simp [smul_add, smul_smul] <;> ring
  have hcoeff : (2 : K) * m = p ∧
      (2 : K) * m + (2 : K) * q = (2 : K) * p := by
    have hv : ((2 : K) * m) • n +
          ((2 : K) * m + (2 : K) * q) • u =
        p • n + ((2 : K) * p) • u := by
      calc
        _ = c.mul (n + (2 : K) • u) (n + (2 : K) • u) := htwoLeft.symm
        _ = p • (n + (2 : K) • u) := htwoSquare
        _ = _ := htwoRight
    exact (pairIndependent_smul_add_eq_smul_add_iff hnuPair
      ((2 : K) * m) ((2 : K) * m + (2 : K) * q)
        p ((2 : K) * p)).mp hv
  have hmq : m = q := by
    have hprod : (2 : K) * (m - q) = 0 := by
      linear_combination 2 * hcoeff.1 - hcoeff.2
    have htwo : (2 : K) ≠ 0 := by norm_num
    exact sub_eq_zero.mp ((mul_eq_zero.mp hprod).resolve_left htwo)
  have hsym : c.mul n u + c.mul u n = q • n := by
    simpa [hmq] using hsymM
  obtain ⟨r0, a, d, hnuRep⟩ :=
    exists_three_coefficients (c.mul n u) hlin
  have henu : c.mul e (c.mul n u) = 0 := by
    calc
      c.mul e (c.mul n u) = c.mul (c.mul e n) u := (ha e n u).symm
      _ = 0 := by rw [hen]; simp [← mulLinear_apply]
  have henuExpansion : c.mul e (c.mul n u) = r0 • e := by
    rw [hnuRep]
    change (mulLinear c e) (r0 • e + a • n + d • u) = r0 • e
    rw [map_add, map_add, map_smul, map_smul, map_smul,
      mulLinear_apply, mulLinear_apply, mulLinear_apply, hee, hen, heu]
    simp
  have hr0 : r0 = 0 := by
    have hv : r0 • e + (0 : K) • n + (0 : K) • u =
        (0 : K) • e + (0 : K) • n + (0 : K) • u := by
      simpa [henuExpansion] using henu
    exact (tripleIndependent_smul_add_smul_add_smul_iff hlin
      r0 0 0 0 0 0).mp hv |>.1
  have hnuRep' : c.mul n u = a • n + d • u := by
    simpa [hr0] using hnuRep
  have hnnu : c.mul n (c.mul n u) = 0 := by
    calc
      c.mul n (c.mul n u) = c.mul (c.mul n n) u := (ha n n u).symm
      _ = 0 := by rw [hnn]; simp [← mulLinear_apply]
  have hnnuExpansion : c.mul n (c.mul n u) =
      (d * a) • n + (d * d) • u := by
    rw [hnuRep']
    change (mulLinear c n) (a • n + d • u) = _
    rw [map_add, map_smul, map_smul, mulLinear_apply, mulLinear_apply,
      hnn, hnuRep']
    apply funext_three <;> simp [smul_add, smul_smul] <;> ring
  have hd2 : d * d = 0 := by
    have hv : (0 : K) • e + (d * a) • n + (d * d) • u =
        (0 : K) • e + (0 : K) • n + (0 : K) • u := by
      simpa [hnnuExpansion] using hnnu
    exact (tripleIndependent_smul_add_smul_add_smul_iff hlin
      0 (d * a) (d * d) 0 0 0).mp hv |>.2.2
  have hd0 : d = 0 := by
    rcases mul_eq_zero.mp hd2 with hd | hd <;> exact hd
  have hnuFinal : c.mul n u = a • n := by simpa [hd0] using hnuRep'
  have hunFinal : c.mul u n = (q - a) • n := by
    calc
      c.mul u n = (c.mul n u + c.mul u n) - c.mul n u := by abel
      _ = q • n - a • n := by rw [hsym, hnuFinal]
      _ = (q - a) • n := by rw [sub_smul]
  have hassoc := ha n u u
  have hleft : c.mul (c.mul n u) u = (a * a) • n := by
    rw [hnuFinal]
    change (mulLinear c (a • n)) u = _
    rw [(mulLinear c).map_smul, LinearMap.smul_apply,
      mulLinear_apply, hnuFinal, smul_smul]
  have hright : c.mul n (c.mul u u) = (q * a) • n := by
    rw [huu]
    change (mulLinear c n) (q • u) = _
    rw [map_smul, mulLinear_apply, hnuFinal, smul_smul]
  have hscalar : a * a = q * a := by
    have hsmul : (a * a) • n = (q * a) • n :=
      hleft.symm.trans (hassoc.trans hright)
    exact smul_left_injective K hnuPair.1 hsmul
  refine ⟨a, q, hnuFinal, hunFinal, huu, ?_⟩
  linear_combination hscalar

/-! ### Identification of the idempotent-annihilator normal forms -/

theorem isomorphic_w4_of_idempotentAnnihilator_zero_extension
    {c : StructureConstants K 3} {e n u : V K}
    (hlin : TripleIndependent e n u)
    (hpair : IsIdempotentAnnihilatorPair c e n)
    (heu : c.mul e u = 0) (hue : c.mul u e = 0)
    (hnu : c.mul n u = 0) (hun : c.mul u n = 0)
    (huu : c.mul u u = 0) :
    Isomorphic c (fixedTable .w4) := by
  rcases hpair with ⟨hee, hen, hne, hnn⟩
  let E := basisEquivOfTripleIndependent hlin
  let T : TableEquiv (fixedTable (K := K) .w4) c :=
    TableEquiv.ofBasis E (by
      intro i j
      fin_cases i <;> fin_cases j <;>
        simp [fixedTable, E, hee, hen, heu, hne, hnn, hnu,
          hue, hun, huu])
  exact ⟨T.symm⟩

theorem isomorphic_w7_of_idempotentAnnihilator_extension
    {c : StructureConstants K 3} {e n u : V K} {q : K}
    (hlin : TripleIndependent e n u)
    (hpair : IsIdempotentAnnihilatorPair c e n)
    (heu : c.mul e u = 0) (hue : c.mul u e = 0)
    (hnu : c.mul n u = 0) (hun : c.mul u n = q • n)
    (huu : c.mul u u = q • u) (hq : q ≠ 0) :
    Isomorphic c (fixedTable .w7) := by
  rcases hpair with ⟨hee, hen, hne, hnn⟩
  let v : V K := q⁻¹ • u
  have hqinv : q⁻¹ ≠ 0 := inv_ne_zero hq
  have hlinv : TripleIndependent e n v := by
    simpa [v] using
      tripleIndependent_replace_third hlin 0 0 q⁻¹ hqinv
  have hev : c.mul e v = 0 := by
    calc
      c.mul e v = (1 * q⁻¹) • c.mul e u := by
        simpa [v] using mul_smul_smul_three c 1 q⁻¹ e u
      _ = 0 := by rw [heu]; simp
  have hve : c.mul v e = 0 := by
    calc
      c.mul v e = (q⁻¹ * 1) • c.mul u e := by
        simpa [v] using mul_smul_smul_three c q⁻¹ 1 u e
      _ = 0 := by rw [hue]; simp
  have hnv : c.mul n v = 0 := by
    calc
      c.mul n v = (1 * q⁻¹) • c.mul n u := by
        simpa [v] using mul_smul_smul_three c 1 q⁻¹ n u
      _ = 0 := by rw [hnu]; simp
  have hvn : c.mul v n = n := by
    calc
      c.mul v n = (q⁻¹ * 1) • c.mul u n := by
        simpa [v] using mul_smul_smul_three c q⁻¹ 1 u n
      _ = n := by rw [hun]; simp [smul_smul, hq]
  have hvv : c.mul v v = v := by
    calc
      c.mul v v = (q⁻¹ * q⁻¹) • c.mul u u := by
        simpa [v] using mul_smul_smul_three c q⁻¹ q⁻¹ u u
      _ = v := by rw [huu]; simp [v, smul_smul, hq]
  let E := basisEquivOfTripleIndependent hlinv
  let T : TableEquiv (fixedTable (K := K) .w7) c :=
    TableEquiv.ofBasis E (by
      intro i j
      fin_cases i <;> fin_cases j <;>
        simp [fixedTable, E, hee, hen, hev, hne, hnn, hnv,
          hve, hvn, hvv])
  exact ⟨T.symm⟩

theorem isomorphic_w8_of_idempotentAnnihilator_extension
    {c : StructureConstants K 3} {e n u : V K} {q : K}
    (hlin : TripleIndependent e n u)
    (hpair : IsIdempotentAnnihilatorPair c e n)
    (heu : c.mul e u = 0) (hue : c.mul u e = 0)
    (hnu : c.mul n u = q • n) (hun : c.mul u n = 0)
    (huu : c.mul u u = q • u) (hq : q ≠ 0) :
    Isomorphic c (fixedTable .w8) := by
  rcases hpair with ⟨hee, hen, hne, hnn⟩
  let v : V K := q⁻¹ • u
  have hqinv : q⁻¹ ≠ 0 := inv_ne_zero hq
  have hlinv : TripleIndependent e n v := by
    simpa [v] using
      tripleIndependent_replace_third hlin 0 0 q⁻¹ hqinv
  have hev : c.mul e v = 0 := by
    calc
      c.mul e v = (1 * q⁻¹) • c.mul e u := by
        simpa [v] using mul_smul_smul_three c 1 q⁻¹ e u
      _ = 0 := by rw [heu]; simp
  have hve : c.mul v e = 0 := by
    calc
      c.mul v e = (q⁻¹ * 1) • c.mul u e := by
        simpa [v] using mul_smul_smul_three c q⁻¹ 1 u e
      _ = 0 := by rw [hue]; simp
  have hnv : c.mul n v = n := by
    calc
      c.mul n v = (1 * q⁻¹) • c.mul n u := by
        simpa [v] using mul_smul_smul_three c 1 q⁻¹ n u
      _ = n := by rw [hnu]; simp [smul_smul, hq]
  have hvn : c.mul v n = 0 := by
    calc
      c.mul v n = (q⁻¹ * 1) • c.mul u n := by
        simpa [v] using mul_smul_smul_three c q⁻¹ 1 u n
      _ = 0 := by rw [hun]; simp
  have hvv : c.mul v v = v := by
    calc
      c.mul v v = (q⁻¹ * q⁻¹) • c.mul u u := by
        simpa [v] using mul_smul_smul_three c q⁻¹ q⁻¹ u u
      _ = v := by rw [huu]; simp [v, smul_smul, hq]
  let E := basisEquivOfTripleIndependent hlinv
  let T : TableEquiv (fixedTable (K := K) .w8) c :=
    TableEquiv.ofBasis E (by
      intro i j
      fin_cases i <;> fin_cases j <;>
        simp [fixedTable, E, hee, hen, hev, hne, hnn, hnv,
          hve, hvn, hvv])
  exact ⟨T.symm⟩

/-- The `00` Peirce branch has exactly the three fixed normal forms `W4`,
`W7`, and `W8`. -/
theorem idempotentAnnihilator_peirce00_classification [CharZero K]
    {c : StructureConstants K 3} (ha : c.MultiplicationAssociative)
    (hnotstraight : ¬ IsStraight c)
    {e n u : V K} (hlin : TripleIndependent e n u)
    (hpair : IsIdempotentAnnihilatorPair c e n)
    (heu : c.mul e u = 0) (hue : c.mul u e = 0) :
    Isomorphic c (fixedTable .w4) ∨
      Isomorphic c (fixedTable .w7) ∨
      Isomorphic c (fixedTable .w8) := by
  have hcurl := peirce00_plane_curled_of_notStraight
    ha hnotstraight hlin hpair heu hue
  obtain ⟨a, q, hnu, hun, huu, haRel⟩ :=
    peirce00_curled_plane_parameters ha hlin hpair heu hue hcurl
  by_cases hq0 : q = 0
  · have ha2 : a * a = 0 := by simpa [hq0] using haRel
    have ha0 : a = 0 := by
      rcases mul_eq_zero.mp ha2 with h | h <;> exact h
    left
    exact isomorphic_w4_of_idempotentAnnihilator_zero_extension
      hlin hpair heu hue (by simpa [ha0] using hnu)
        (by simpa [hq0, ha0] using hun) (by simpa [hq0] using huu)
  · rcases mul_eq_zero.mp haRel with ha0 | haq
    · right
      left
      exact isomorphic_w7_of_idempotentAnnihilator_extension
        hlin hpair heu hue (by simpa [ha0] using hnu)
          (by simpa [ha0] using hun) huu hq0
    · right
      right
      have haeq : a = q := sub_eq_zero.mp haq
      exact isomorphic_w8_of_idempotentAnnihilator_extension
        hlin hpair heu hue (by simpa [haeq] using hnu)
          (by simpa [haeq] using hun) huu hq0

/-- If an idempotent acts in the same way on every member of a displayed
basis from the left and the right, it commutes with every vector. -/
theorem idempotent_commutes_of_peirce11_basis
    {c : StructureConstants K 3} {e n u : V K}
    (hlin : TripleIndependent e n u)
    (hpair : IsIdempotentAnnihilatorPair c e n)
    (heu : c.mul e u = u) (hue : c.mul u e = u) (x : V K) :
    c.mul e x = c.mul x e := by
  rcases hpair with ⟨hee, hen, hne, _hnn⟩
  obtain ⟨a, b, d, hx⟩ := exists_three_coefficients x hlin
  rw [hx, mul_second_linearCombination_three,
    mul_first_linearCombination_three, hee, hen, heu, hne, hue]

/-- A `11` Peirce complement forces a straight generator.  Thus it cannot
occur in the waved sector. -/
theorem isStraight_of_idempotentAnnihilator_peirce11 [CharZero K]
    {c : StructureConstants K 3} (ha : c.MultiplicationAssociative)
    {e n u : V K} (hlin : TripleIndependent e n u)
    (hpair : IsIdempotentAnnihilatorPair c e n)
    (heu : c.mul e u = u) (hue : c.mul u e = u) :
    IsStraight c := by
  rcases hpair with ⟨hee, hen, hne, hnn⟩
  have hcomm := idempotent_commutes_of_peirce11_basis
    hlin ⟨hee, hen, hne, hnn⟩ heu hue
  have hnuLeft : c.mul e (c.mul n u) = 0 := by
    calc
      c.mul e (c.mul n u) = c.mul (c.mul e n) u := (ha e n u).symm
      _ = 0 := by rw [hen]; simp [← mulLinear_apply]
  have hnuRight : c.mul (c.mul n u) e = c.mul n u := by
    calc
      c.mul (c.mul n u) e = c.mul n (c.mul u e) := ha n u e
      _ = c.mul n u := by rw [hue]
  have hnu : c.mul n u = 0 := by
    calc
      c.mul n u = c.mul (c.mul n u) e := hnuRight.symm
      _ = c.mul e (c.mul n u) := (hcomm (c.mul n u)).symm
      _ = 0 := hnuLeft
  have hunLeft : c.mul e (c.mul u n) = c.mul u n := by
    calc
      c.mul e (c.mul u n) = c.mul (c.mul e u) n := (ha e u n).symm
      _ = c.mul u n := by rw [heu]
  have hunRight : c.mul (c.mul u n) e = 0 := by
    calc
      c.mul (c.mul u n) e = c.mul u (c.mul n e) := ha u n e
      _ = 0 := by rw [hne]; simp [← mulLinear_apply]
  have hun : c.mul u n = 0 := by
    calc
      c.mul u n = c.mul e (c.mul u n) := hunLeft.symm
      _ = c.mul (c.mul u n) e := hcomm (c.mul u n)
      _ = 0 := hunRight
  obtain ⟨a, b, d, huuRep⟩ :=
    exists_three_coefficients (c.mul u u) hlin
  have heuu : c.mul e (c.mul u u) = c.mul u u := by
    calc
      c.mul e (c.mul u u) = c.mul (c.mul e u) u := (ha e u u).symm
      _ = c.mul u u := by rw [heu]
  have heuuExpansion : c.mul e (c.mul u u) = a • e + d • u := by
    rw [huuRep]
    change (mulLinear c e) (a • e + b • n + d • u) = _
    rw [map_add, map_add, map_smul, map_smul, map_smul,
      mulLinear_apply, mulLinear_apply, mulLinear_apply, hee, hen, heu]
    simp
  have hb0 : b = 0 := by
    have hcore : a • e + d • u = a • e + b • n + d • u :=
      heuuExpansion.symm.trans (heuu.trans huuRep)
    have hv : a • e + (0 : K) • n + d • u =
        a • e + b • n + d • u := by
      simpa using hcore
    exact ((tripleIndependent_smul_add_smul_add_smul_iff hlin
      a 0 d a b d).mp hv |>.2.1).symm
  have huu : c.mul u u = a • e + d • u := by
    simpa [hb0] using huuRep
  obtain ⟨t, _ht, htpoly⟩ := exists_nonzero_quadratic_avoidance a (-d)
  let A : K := a - d * t - t * t
  let B : K := d + 2 * t
  have hA : A ≠ 0 := by
    intro hA0
    apply htpoly
    dsimp [A] at hA0
    linear_combination -hA0
  let x : V K := u + t • e
  have hlinNEX : TripleIndependent n e x := by
    have hreplace := tripleIndependent_replace_third
      (tripleIndependent_swap_first hlin) 0 t 1 one_ne_zero
    simpa [x, add_comm, add_left_comm, add_assoc] using hreplace
  have hex : c.mul e x = x := by
    calc
      c.mul e x = c.mul e (u + t • e) := by rfl
      _ = c.mul e u + t • c.mul e e := by
        change (mulLinear c e) (u + t • e) = _
        rw [map_add, map_smul, mulLinear_apply, mulLinear_apply]
      _ = x := by rw [heu, hee]
  have hxe : c.mul x e = x := by
    calc
      c.mul x e = c.mul (u + t • e) e := by rfl
      _ = c.mul u e + t • c.mul e e := by
        change (mulLinear c (u + t • e)) e = _
        rw [(mulLinear c).map_add, (mulLinear c).map_smul,
          LinearMap.add_apply, LinearMap.smul_apply,
          mulLinear_apply, mulLinear_apply]
      _ = x := by rw [hue, hee]
  have hnx : c.mul n x = 0 := by
    calc
      c.mul n x = c.mul n (u + t • e) := by rfl
      _ = c.mul n u + t • c.mul n e := by
        change (mulLinear c n) (u + t • e) = _
        rw [map_add, map_smul, mulLinear_apply, mulLinear_apply]
      _ = 0 := by rw [hnu, hne]; simp
  have hxn : c.mul x n = 0 := by
    calc
      c.mul x n = c.mul (u + t • e) n := by rfl
      _ = c.mul u n + t • c.mul e n := by
        change (mulLinear c (u + t • e)) n = _
        rw [(mulLinear c).map_add, (mulLinear c).map_smul,
          LinearMap.add_apply, LinearMap.smul_apply,
          mulLinear_apply, mulLinear_apply]
      _ = 0 := by rw [hun, hen]; simp
  have hxx : c.mul x x = A • e + B • x := by
    calc
      c.mul x x = c.mul ((1 : K) • u + t • e)
          ((1 : K) • u + t • e) := by simp [x]
      _ = ((1 : K) * 1) • c.mul u u +
            ((1 : K) * t) • c.mul u e +
              (t * 1) • c.mul e u + (t * t) • c.mul e e :=
        mul_linearCombination_pair_three c u e 1 t 1 t
      _ = A • e + B • x := by
        rw [huu, hue, heu, hee]
        apply funext_three <;>
          simp [A, B, x, smul_add, smul_smul] <;> ring
  have hxxx : c.mul (c.mul x x) x =
      (A * B) • e + (A + B * B) • x := by
    rw [hxx]
    change (mulLinear c (A • e + B • x)) x = _
    rw [(mulLinear c).map_add, (mulLinear c).map_smul,
      (mulLinear c).map_smul, LinearMap.add_apply,
      LinearMap.smul_apply, LinearMap.smul_apply,
      mulLinear_apply, mulLinear_apply, hex, hxx]
    apply funext_three <;> simp [smul_add, smul_smul] <;> ring
  have hdet : A * (A + B * B) - B * (A * B) ≠ 0 := by
    have hAA : A * A ≠ 0 := mul_ne_zero hA hA
    convert hAA using 1 <;> ring
  have hplane : TripleIndependent (c.mul x x) (c.mul (c.mul x x) x) n := by
    have hchange := tripleIndependent_plane_change
      (tripleIndependent_cycle hlinNEX)
        A B (A * B) (A + B * B) hdet
    rw [← hxx, ← hxxx] at hchange
    exact hchange
  have hbase : TripleIndependent n (c.mul x x) (c.mul (c.mul x x) x) :=
    tripleIndependent_cycle (tripleIndependent_cycle hplane)
  have hxSpan : x =
      (-(A⁻¹ * B)) • c.mul x x + A⁻¹ • c.mul (c.mul x x) x := by
    rw [hxxx, hxx]
    apply funext_three <;>
      simp [smul_add, smul_smul] <;> field_simp [hA] <;> ring
  have hybasis : TripleIndependent
      (n + x) (c.mul x x) (c.mul (c.mul x x) x) := by
    have hfirst : n + x = n +
        ((-(A⁻¹ * B)) • c.mul x x +
          A⁻¹ • c.mul (c.mul x x) x) := congrArg (fun v => n + v) hxSpan
    rw [hfirst]
    exact tripleIndependent_add_span_to_first hbase (-(A⁻¹ * B)) A⁻¹
  let y : V K := n + x
  have hyy : c.mul y y = c.mul x x := by
    calc
      c.mul y y = c.mul ((1 : K) • n + (1 : K) • x)
          ((1 : K) • n + (1 : K) • x) := by simp [y]
      _ = ((1 : K) * 1) • c.mul n n +
            ((1 : K) * 1) • c.mul n x +
              ((1 : K) * 1) • c.mul x n +
                ((1 : K) * 1) • c.mul x x :=
        mul_linearCombination_pair_three c n x 1 1 1 1
      _ = c.mul x x := by rw [hnn, hnx, hxn]; simp
  have hxxn : c.mul (c.mul x x) n = 0 := by
    rw [hxx]
    change (mulLinear c (A • e + B • x)) n = 0
    rw [(mulLinear c).map_add, (mulLinear c).map_smul,
      (mulLinear c).map_smul, LinearMap.add_apply,
      LinearMap.smul_apply, LinearMap.smul_apply,
      mulLinear_apply, mulLinear_apply, hen, hxn]
    simp
  have hyyy : c.mul (c.mul y y) y = c.mul (c.mul x x) x := by
    rw [hyy]
    calc
      c.mul (c.mul x x) y = c.mul (c.mul x x) (n + x) := by rfl
      _ = c.mul (c.mul x x) n + c.mul (c.mul x x) x := by
        change (mulLinear c (c.mul x x)) (n + x) = _
        rw [map_add, mulLinear_apply, mulLinear_apply]
      _ = c.mul (c.mul x x) x := by rw [hxxn]; simp
  refine ⟨y, ?_⟩
  rw [hyyy, hyy]
  simpa only [y] using hybasis

/-- Complete classification of the nonstraight branch containing an
idempotent-annihilator plane. -/
theorem nonstraight_idempotentAnnihilator_classification [CharZero K]
    {c : StructureConstants K 3} (ha : c.MultiplicationAssociative)
    (hnotstraight : ¬ IsStraight c)
    {e n g : V K} (hlin : TripleIndependent e n g)
    (hpair : IsIdempotentAnnihilatorPair c e n) :
    Isomorphic c (fixedTable .w4) ∨
      Isomorphic c (fixedTable .w5) ∨
      Isomorphic c (fixedTable .w6) ∨
      Isomorphic c (fixedTable .w7) ∨
      Isomorphic c (fixedTable .w8) := by
  obtain ⟨u, hlinu, h00 | h01 | h10 | h11⟩ :=
    exists_peirce_basis_of_idempotentAnnihilator ha hlin hpair
  · rcases idempotentAnnihilator_peirce00_classification
      ha hnotstraight hlinu hpair h00.1 h00.2 with h4 | h7 | h8
    · exact Or.inl h4
    · exact Or.inr (Or.inr (Or.inr (Or.inl h7)))
    · exact Or.inr (Or.inr (Or.inr (Or.inr h8)))
  · exact Or.inr (Or.inr (Or.inl
      (isomorphic_w6_of_peirce01_basis ha hlinu hpair h01.1 h01.2)))
  · exact Or.inr (Or.inl
      (isomorphic_w5_of_peirce10_basis ha hlinu hpair h10.1 h10.2))
  · exact False.elim (hnotstraight
      (isStraight_of_idempotentAnnihilator_peirce11
        ha hlinu hpair h11.1 h11.2))

/-! ## Peirce reduction around a unital quadratic plane -/

/-- A basis containing the identity of a quadratic subalgebra can be refined
so that its complementary vector belongs to a single Peirce component. -/
theorem exists_peirce_basis_of_quadraticPair
    {c : StructureConstants K 3} (ha : c.MultiplicationAssociative)
    {delta : K} {e p g : V K} (hlin : TripleIndependent e p g)
    (hquad : IsQuadraticPair c delta e p) :
    ∃ u : V K, TripleIndependent e p u ∧
      ((c.mul e u = 0 ∧ c.mul u e = 0) ∨
        (c.mul e u = 0 ∧ c.mul u e = u) ∨
        (c.mul e u = u ∧ c.mul u e = 0) ∨
        (c.mul e u = u ∧ c.mul u e = u)) := by
  rcases hquad with ⟨hee, hep, hpe, _hpp⟩
  obtain ⟨a0, a1, a2, heg⟩ :=
    exists_three_coefficients (c.mul e g) hlin
  obtain ⟨b0, b1, b2, hge⟩ :=
    exists_three_coefficients (c.mul g e) hlin
  have hLeg : c.mul e (c.mul e g) = c.mul e g := by
    calc
      c.mul e (c.mul e g) = c.mul (c.mul e e) g := (ha e e g).symm
      _ = c.mul e g := by rw [hee]
  have hLegExpansion : c.mul e (c.mul e g) =
      (a0 + a2 * a0) • e + (a1 + a2 * a1) • p + (a2 * a2) • g := by
    rw [heg]
    change (mulLinear c e) (a0 • e + a1 • p + a2 • g) = _
    rw [map_add, map_add, map_smul, map_smul, map_smul,
      mulLinear_apply, mulLinear_apply, mulLinear_apply, hee, hep, heg]
    apply funext_three <;> simp [smul_add, smul_smul] <;> ring
  have hLeftCoeffs :=
    (tripleIndependent_smul_add_smul_add_smul_iff hlin
      (a0 + a2 * a0) (a1 + a2 * a1) (a2 * a2) a0 a1 a2).mp
      (hLegExpansion.symm.trans (hLeg.trans heg))
  have ha2cases : a2 = 0 ∨ a2 = 1 := by
    have hprod : a2 * (a2 - 1) = 0 := by
      linear_combination hLeftCoeffs.2.2
    rcases mul_eq_zero.mp hprod with h | h
    · exact Or.inl h
    · exact Or.inr (sub_eq_zero.mp h)
  have hgeR : c.mul (c.mul g e) e = c.mul g e := by
    calc
      c.mul (c.mul g e) e = c.mul g (c.mul e e) := ha g e e
      _ = c.mul g e := by rw [hee]
  have hgeRExpansion : c.mul (c.mul g e) e =
      (b0 + b2 * b0) • e + (b1 + b2 * b1) • p + (b2 * b2) • g := by
    rw [hge]
    change (mulLinear c (b0 • e + b1 • p + b2 • g)) e = _
    rw [(mulLinear c).map_add, (mulLinear c).map_add,
      (mulLinear c).map_smul, (mulLinear c).map_smul,
      (mulLinear c).map_smul, LinearMap.add_apply, LinearMap.add_apply,
      LinearMap.smul_apply, LinearMap.smul_apply, LinearMap.smul_apply,
      mulLinear_apply, mulLinear_apply, mulLinear_apply, hee, hpe, hge]
    apply funext_three <;> simp [smul_add, smul_smul] <;> ring
  have hRightCoeffs :=
    (tripleIndependent_smul_add_smul_add_smul_iff hlin
      (b0 + b2 * b0) (b1 + b2 * b1) (b2 * b2) b0 b1 b2).mp
      (hgeRExpansion.symm.trans (hgeR.trans hge))
  have hb2cases : b2 = 0 ∨ b2 = 1 := by
    have hprod : b2 * (b2 - 1) = 0 := by
      linear_combination hRightCoeffs.2.2
    rcases mul_eq_zero.mp hprod with h | h
    · exact Or.inl h
    · exact Or.inr (sub_eq_zero.mp h)
  have hcrossExpansion : c.mul e (c.mul g e) =
      (b0 + b2 * a0) • e + (b1 + b2 * a1) • p + (b2 * a2) • g := by
    rw [hge]
    change (mulLinear c e) (b0 • e + b1 • p + b2 • g) = _
    rw [map_add, map_add, map_smul, map_smul, map_smul,
      mulLinear_apply, mulLinear_apply, mulLinear_apply, hee, hep, heg]
    apply funext_three <;> simp [smul_add, smul_smul] <;> ring
  rcases ha2cases with ha20 | ha21 <;> rcases hb2cases with hb20 | hb21
  · let u := peirce00 c e g
    have huRep : u =
        (-a0 + b2 * a0) • e + (-a1 + b2 * a1) • p + (1 : K) • g := by
      rw [show u = g - c.mul e g - c.mul g e +
          c.mul e (c.mul g e) by rfl, hcrossExpansion, heg, hge]
      apply funext_three <;>
        simp [ha20, hb20, smul_add, smul_smul] <;> ring
    have hlinu : TripleIndependent e p u := by
      rw [huRep]
      exact tripleIndependent_replace_third hlin
        (-a0 + b2 * a0) (-a1 + b2 * a1) 1 one_ne_zero
    exact ⟨u, hlinu, Or.inl (peirce00_relations ha hee)⟩
  · let u := peirce01 c e g
    have huRep : u =
        (-b2 * a0) • e + (-b2 * a1) • p + (1 : K) • g := by
      rw [show u = c.mul g e - c.mul e (c.mul g e) by rfl,
        hcrossExpansion, hge]
      apply funext_three <;>
        simp [ha20, hb21, smul_add, smul_smul] <;> ring
    have hlinu : TripleIndependent e p u := by
      rw [huRep]
      exact tripleIndependent_replace_third hlin
        (-b2 * a0) (-b2 * a1) 1 one_ne_zero
    exact ⟨u, hlinu, Or.inr (Or.inl (peirce01_relations ha hee))⟩
  · let u := peirce10 c e g
    have huRep : u =
        (a0 - b0 - b2 * a0) • e +
          (a1 - b1 - b2 * a1) • p + (1 : K) • g := by
      rw [show u = c.mul e g - c.mul e (c.mul g e) by rfl,
        hcrossExpansion, heg]
      apply funext_three <;>
        simp [ha21, hb20, smul_add, smul_smul] <;> ring
    have hlinu : TripleIndependent e p u := by
      rw [huRep]
      exact tripleIndependent_replace_third hlin
        (a0 - b0 - b2 * a0) (a1 - b1 - b2 * a1) 1 one_ne_zero
    exact ⟨u, hlinu, Or.inr (Or.inr (Or.inl (peirce10_relations ha hee)))⟩
  · let u := peirce11 c e g
    have huRep : u =
        (b0 + b2 * a0) • e + (b1 + b2 * a1) • p + (1 : K) • g := by
      rw [show u = c.mul e (c.mul g e) by rfl, hcrossExpansion]
      apply funext_three <;>
        simp [ha21, hb21, smul_add, smul_smul] <;> ring
    have hlinu : TripleIndependent e p u := by
      rw [huRep]
      exact tripleIndependent_replace_third hlin
        (b0 + b2 * a0) (b1 + b2 * a1) 1 one_ne_zero
    exact ⟨u, hlinu, Or.inr (Or.inr (Or.inr (peirce11_relations ha hee)))⟩

theorem isomorphic_w9_of_quadratic_peirce01_zero
    {c : StructureConstants K 3} {e p u : V K}
    (hlin : TripleIndependent e p u)
    (hquad : IsQuadraticPair c 0 e p)
    (heu : c.mul e u = 0) (hue : c.mul u e = u)
    (hpu : c.mul p u = 0) (hup : c.mul u p = 0)
    (huu : c.mul u u = 0) :
    Isomorphic c (fixedTable .w9) := by
  rcases hquad with ⟨hee, hep, hpe, hpp⟩
  have hlin' : TripleIndependent p e u := tripleIndependent_swap_first hlin
  let E := basisEquivOfTripleIndependent hlin'
  let T : TableEquiv (fixedTable (K := K) .w9) c :=
    TableEquiv.ofBasis E (by
      intro i j
      fin_cases i <;> fin_cases j <;>
        simp [fixedTable, E, hee, hep, heu, hpe, hpp, hpu,
          hue, hup, huu])
  exact ⟨T.symm⟩

theorem isomorphic_w10_of_quadratic_peirce10_zero
    {c : StructureConstants K 3} {e p u : V K}
    (hlin : TripleIndependent e p u)
    (hquad : IsQuadraticPair c 0 e p)
    (heu : c.mul e u = u) (hue : c.mul u e = 0)
    (hpu : c.mul p u = 0) (hup : c.mul u p = 0)
    (huu : c.mul u u = 0) :
    Isomorphic c (fixedTable .w10) := by
  rcases hquad with ⟨hee, hep, hpe, hpp⟩
  have hlin' : TripleIndependent p e u := tripleIndependent_swap_first hlin
  let E := basisEquivOfTripleIndependent hlin'
  let T : TableEquiv (fixedTable (K := K) .w10) c :=
    TableEquiv.ofBasis E (by
      intro i j
      fin_cases i <;> fin_cases j <;>
        simp [fixedTable, E, hee, hep, heu, hpe, hpp, hpu,
          hue, hup, huu])
  exact ⟨T.symm⟩

/-- A `01` complement to a quadratic plane is either the exceptional form
`W9`, or (when its quadratic eigenvalue is nonzero) contains an
idempotent-annihilator plane and hence reduces to `W4`--`W8`. -/
theorem quadratic_peirce01_classification [CharZero K]
    {c : StructureConstants K 3} (ha : c.MultiplicationAssociative)
    (hnotstraight : ¬ IsStraight c)
    {delta : K} {e p u : V K} (hlin : TripleIndependent e p u)
    (hquad : IsQuadraticPair c delta e p)
    (heu : c.mul e u = 0) (hue : c.mul u e = u) :
    (Isomorphic c (fixedTable .w4) ∨
      Isomorphic c (fixedTable .w5) ∨
      Isomorphic c (fixedTable .w6) ∨
      Isomorphic c (fixedTable .w7) ∨
      Isomorphic c (fixedTable .w8)) ∨
      Isomorphic c (fixedTable .w9) := by
  rcases hquad with ⟨hee, hep, hpe, hpp⟩
  have hpu : c.mul p u = 0 := by
    calc
      c.mul p u = c.mul (c.mul p e) u := by rw [hpe]
      _ = c.mul p (c.mul e u) := ha p e u
      _ = 0 := by rw [heu]; simp [← mulLinear_apply]
  have huu : c.mul u u = 0 := by
    calc
      c.mul u u = c.mul (c.mul u e) u := by rw [hue]
      _ = c.mul u (c.mul e u) := ha u e u
      _ = 0 := by rw [heu]; simp [← mulLinear_apply]
  obtain ⟨a, b, r, hupRep⟩ :=
    exists_three_coefficients (c.mul u p) hlin
  have heup : c.mul e (c.mul u p) = 0 := by
    calc
      c.mul e (c.mul u p) = c.mul (c.mul e u) p := (ha e u p).symm
      _ = 0 := by rw [heu]; simp [← mulLinear_apply]
  have heupExpansion : c.mul e (c.mul u p) = a • e + b • p := by
    rw [hupRep]
    change (mulLinear c e) (a • e + b • p + r • u) = _
    rw [map_add, map_add, map_smul, map_smul, map_smul,
      mulLinear_apply, mulLinear_apply, mulLinear_apply, hee, hep, heu]
    simp
  have hab0 : a = 0 ∧ b = 0 := by
    have hv : a • e + b • p + (0 : K) • u =
        (0 : K) • e + (0 : K) • p + (0 : K) • u := by
      simpa [heupExpansion] using heup
    have hc := (tripleIndependent_smul_add_smul_add_smul_iff hlin
      a b 0 0 0 0).mp hv
    exact ⟨hc.1, hc.2.1⟩
  have hup : c.mul u p = r • u := by
    simpa [hab0.1, hab0.2] using hupRep
  have hassoc := ha u p p
  have hleft : c.mul (c.mul u p) p = (r * r) • u := by
    rw [hup]
    change (mulLinear c (r • u)) p = _
    rw [(mulLinear c).map_smul, LinearMap.smul_apply,
      mulLinear_apply, hup, smul_smul]
  have hright : c.mul u (c.mul p p) = delta • u := by
    rw [hpp]
    change (mulLinear c u) (delta • e) = _
    rw [map_smul, mulLinear_apply, hue]
  have hu0 : u ≠ 0 := by
    have hli := hlin
    rw [TripleIndependent] at hli
    simpa using hli.ne_zero 2
  have hrdelta : r * r = delta := by
    exact smul_left_injective K hu0 (hleft.symm.trans (hassoc.trans hright))
  by_cases hr0 : r = 0
  · right
    have hdelta0 : delta = 0 := by simpa [hr0] using hrdelta.symm
    exact isomorphic_w9_of_quadratic_peirce01_zero hlin
      ⟨hee, hep, hpe, by simpa [hdelta0] using hpp⟩ heu hue hpu
        (by simpa [hr0] using hup) huu
  · left
    let s : K := (2 : K)⁻¹
    let v : V K := s • e - (s * r⁻¹) • p
    have hs : s ≠ 0 := inv_ne_zero (by norm_num)
    have hdet : s * 0 - (-(s * r⁻¹)) * 1 ≠ 0 := by
      simpa using mul_ne_zero hs (inv_ne_zero hr0)
    have hlinVEU : TripleIndependent v e u := by
      simpa [v, sub_eq_add_neg] using
        tripleIndependent_plane_change hlin s (-(s * r⁻¹)) 1 0 hdet
    have hlinVUE : TripleIndependent v u e :=
      tripleIndependent_swap_last hlinVEU
    have hvv : c.mul v v = v := by
      calc
        c.mul v v = c.mul (s • e + (-(s * r⁻¹)) • p)
            (s • e + (-(s * r⁻¹)) • p) := by
          simp [v, sub_eq_add_neg]
        _ = (s * s) • c.mul e e +
              (s * (-(s * r⁻¹))) • c.mul e p +
                ((-(s * r⁻¹)) * s) • c.mul p e +
                  ((-(s * r⁻¹)) * (-(s * r⁻¹))) • c.mul p p :=
          mul_linearCombination_pair_three c e p s (-(s * r⁻¹))
            s (-(s * r⁻¹))
        _ = v := by
          rw [hee, hep, hpe, hpp, ← hrdelta]
          apply funext_three <;>
            simp [v, s, sub_eq_add_neg, smul_add, smul_smul] <;>
              field_simp [hr0] <;> ring
    have hvu : c.mul v u = 0 := by
      calc
        c.mul v u = c.mul (s • e - (s * r⁻¹) • p) u := by rfl
        _ = s • c.mul e u - (s * r⁻¹) • c.mul p u := by
          change (mulLinear c (s • e - (s * r⁻¹) • p)) u = _
          rw [(mulLinear c).map_sub, (mulLinear c).map_smul,
            (mulLinear c).map_smul, LinearMap.sub_apply,
            LinearMap.smul_apply, LinearMap.smul_apply,
            mulLinear_apply, mulLinear_apply]
        _ = 0 := by rw [heu, hpu]; simp
    have huv : c.mul u v = 0 := by
      calc
        c.mul u v = c.mul u (s • e - (s * r⁻¹) • p) := by rfl
        _ = s • c.mul u e - (s * r⁻¹) • c.mul u p := by
          change (mulLinear c u) (s • e - (s * r⁻¹) • p) = _
          rw [map_sub, map_smul, map_smul, mulLinear_apply, mulLinear_apply]
        _ = 0 := by
          rw [hue, hup]
          apply funext_three <;>
            simp [s, smul_smul] <;> field_simp [hr0] <;> ring
    exact nonstraight_idempotentAnnihilator_classification
      ha hnotstraight hlinVUE ⟨hvv, hvu, huv, huu⟩

/-- The left-right dual `10` case gives `W10` at eigenvalue zero and otherwise
reduces to an idempotent-annihilator plane. -/
theorem quadratic_peirce10_classification [CharZero K]
    {c : StructureConstants K 3} (ha : c.MultiplicationAssociative)
    (hnotstraight : ¬ IsStraight c)
    {delta : K} {e p u : V K} (hlin : TripleIndependent e p u)
    (hquad : IsQuadraticPair c delta e p)
    (heu : c.mul e u = u) (hue : c.mul u e = 0) :
    (Isomorphic c (fixedTable .w4) ∨
      Isomorphic c (fixedTable .w5) ∨
      Isomorphic c (fixedTable .w6) ∨
      Isomorphic c (fixedTable .w7) ∨
      Isomorphic c (fixedTable .w8)) ∨
      Isomorphic c (fixedTable .w10) := by
  rcases hquad with ⟨hee, hep, hpe, hpp⟩
  have hup : c.mul u p = 0 := by
    calc
      c.mul u p = c.mul u (c.mul e p) := by rw [hep]
      _ = c.mul (c.mul u e) p := (ha u e p).symm
      _ = 0 := by rw [hue]; simp [← mulLinear_apply]
  have huu0 : c.mul u u = 0 := by
    calc
      c.mul u u = c.mul u (c.mul e u) := by rw [heu]
      _ = c.mul (c.mul u e) u := (ha u e u).symm
      _ = 0 := by rw [hue]; simp [← mulLinear_apply]
  obtain ⟨a, b, r, hpuRep⟩ :=
    exists_three_coefficients (c.mul p u) hlin
  have hpue : c.mul (c.mul p u) e = 0 := by
    calc
      c.mul (c.mul p u) e = c.mul p (c.mul u e) := ha p u e
      _ = 0 := by rw [hue]; simp [← mulLinear_apply]
  have hpueExpansion : c.mul (c.mul p u) e = a • e + b • p := by
    rw [hpuRep]
    change (mulLinear c (a • e + b • p + r • u)) e = _
    rw [(mulLinear c).map_add, (mulLinear c).map_add,
      (mulLinear c).map_smul, (mulLinear c).map_smul,
      (mulLinear c).map_smul, LinearMap.add_apply, LinearMap.add_apply,
      LinearMap.smul_apply, LinearMap.smul_apply, LinearMap.smul_apply,
      mulLinear_apply, mulLinear_apply, mulLinear_apply, hee, hpe, hue]
    simp
  have hab0 : a = 0 ∧ b = 0 := by
    have hv : a • e + b • p + (0 : K) • u =
        (0 : K) • e + (0 : K) • p + (0 : K) • u := by
      simpa [hpueExpansion] using hpue
    have hc := (tripleIndependent_smul_add_smul_add_smul_iff hlin
      a b 0 0 0 0).mp hv
    exact ⟨hc.1, hc.2.1⟩
  have hpu : c.mul p u = r • u := by
    simpa [hab0.1, hab0.2] using hpuRep
  have hassoc := ha p p u
  have hleft : c.mul (c.mul p p) u = delta • u := by
    rw [hpp]
    change (mulLinear c (delta • e)) u = _
    rw [(mulLinear c).map_smul, LinearMap.smul_apply,
      mulLinear_apply, heu]
  have hright : c.mul p (c.mul p u) = (r * r) • u := by
    rw [hpu]
    change (mulLinear c p) (r • u) = _
    rw [map_smul, mulLinear_apply, hpu, smul_smul]
  have hu0 : u ≠ 0 := by
    have hli := hlin
    rw [TripleIndependent] at hli
    simpa using hli.ne_zero 2
  have hrdelta : r * r = delta := by
    exact smul_left_injective K hu0
      (hright.symm.trans (hassoc.symm.trans hleft))
  by_cases hr0 : r = 0
  · right
    have hdelta0 : delta = 0 := by simpa [hr0] using hrdelta.symm
    exact isomorphic_w10_of_quadratic_peirce10_zero hlin
      ⟨hee, hep, hpe, by simpa [hdelta0] using hpp⟩ heu hue
        (by simpa [hr0] using hpu) hup huu0
  · left
    let s : K := (2 : K)⁻¹
    let v : V K := s • e - (s * r⁻¹) • p
    have hs : s ≠ 0 := inv_ne_zero (by norm_num)
    have hdet : s * 0 - (-(s * r⁻¹)) * 1 ≠ 0 := by
      simpa using mul_ne_zero hs (inv_ne_zero hr0)
    have hlinVEU : TripleIndependent v e u := by
      simpa [v, sub_eq_add_neg] using
        tripleIndependent_plane_change hlin s (-(s * r⁻¹)) 1 0 hdet
    have hlinVUE : TripleIndependent v u e :=
      tripleIndependent_swap_last hlinVEU
    have hvv : c.mul v v = v := by
      calc
        c.mul v v = c.mul (s • e + (-(s * r⁻¹)) • p)
            (s • e + (-(s * r⁻¹)) • p) := by
          simp [v, sub_eq_add_neg]
        _ = (s * s) • c.mul e e +
              (s * (-(s * r⁻¹))) • c.mul e p +
                ((-(s * r⁻¹)) * s) • c.mul p e +
                  ((-(s * r⁻¹)) * (-(s * r⁻¹))) • c.mul p p :=
          mul_linearCombination_pair_three c e p s (-(s * r⁻¹))
            s (-(s * r⁻¹))
        _ = v := by
          rw [hee, hep, hpe, hpp, ← hrdelta]
          apply funext_three <;>
            simp [v, s, sub_eq_add_neg, smul_add, smul_smul] <;>
              field_simp [hr0] <;> ring
    have hvu : c.mul v u = 0 := by
      calc
        c.mul v u = c.mul (s • e - (s * r⁻¹) • p) u := by rfl
        _ = s • c.mul e u - (s * r⁻¹) • c.mul p u := by
          change (mulLinear c (s • e - (s * r⁻¹) • p)) u = _
          rw [(mulLinear c).map_sub, (mulLinear c).map_smul,
            (mulLinear c).map_smul, LinearMap.sub_apply,
            LinearMap.smul_apply, LinearMap.smul_apply,
            mulLinear_apply, mulLinear_apply]
        _ = 0 := by
          rw [heu, hpu]
          apply funext_three <;>
            simp [s, smul_smul] <;> field_simp [hr0] <;> ring
    have huv : c.mul u v = 0 := by
      calc
        c.mul u v = c.mul u (s • e - (s * r⁻¹) • p) := by rfl
        _ = s • c.mul u e - (s * r⁻¹) • c.mul u p := by
          change (mulLinear c u) (s • e - (s * r⁻¹) • p) = _
          rw [map_sub, map_smul, map_smul, mulLinear_apply, mulLinear_apply]
        _ = 0 := by rw [hue, hup]; simp
    exact nonstraight_idempotentAnnihilator_classification
      ha hnotstraight hlinVUE ⟨hvv, hvu, huv, huu0⟩

/-- A `00` complement to a quadratic plane is never genuinely waved: a
nonzero square coefficient supplies a global identity, while a square-zero
complement supplies an explicit straight generator. -/
theorem quadratic_peirce00_unital_or_straight [CharZero K]
    {c : StructureConstants K 3} (ha : c.MultiplicationAssociative)
    {delta : K} {e p u : V K} (hlin : TripleIndependent e p u)
    (hquad : IsQuadraticPair c delta e p)
    (heu : c.mul e u = 0) (hue : c.mul u e = 0) :
    HasTwoSidedIdentity c ∨ IsStraight c := by
  rcases hquad with ⟨hee, hep, hpe, hpp⟩
  have hpu : c.mul p u = 0 := by
    calc
      c.mul p u = c.mul (c.mul p e) u := by rw [hpe]
      _ = c.mul p (c.mul e u) := ha p e u
      _ = 0 := by rw [heu]; simp [← mulLinear_apply]
  have hup : c.mul u p = 0 := by
    calc
      c.mul u p = c.mul u (c.mul e p) := by rw [hep]
      _ = c.mul (c.mul u e) p := (ha u e p).symm
      _ = 0 := by rw [hue]; simp [← mulLinear_apply]
  obtain ⟨a, b, k, huuRep⟩ :=
    exists_three_coefficients (c.mul u u) hlin
  have heuu : c.mul e (c.mul u u) = 0 := by
    calc
      c.mul e (c.mul u u) = c.mul (c.mul e u) u := (ha e u u).symm
      _ = 0 := by rw [heu]; simp [← mulLinear_apply]
  have heuuExpansion : c.mul e (c.mul u u) = a • e + b • p := by
    rw [huuRep]
    change (mulLinear c e) (a • e + b • p + k • u) = _
    rw [map_add, map_add, map_smul, map_smul, map_smul,
      mulLinear_apply, mulLinear_apply, mulLinear_apply, hee, hep, heu]
    simp
  have hab0 : a = 0 ∧ b = 0 := by
    have hv : a • e + b • p + (0 : K) • u =
        (0 : K) • e + (0 : K) • p + (0 : K) • u := by
      simpa [heuuExpansion] using heuu
    have hc := (tripleIndependent_smul_add_smul_add_smul_iff hlin
      a b 0 0 0 0).mp hv
    exact ⟨hc.1, hc.2.1⟩
  have huu : c.mul u u = k • u := by
    simpa [hab0.1, hab0.2] using huuRep
  by_cases hk0 : k = 0
  · right
    have huu0 : c.mul u u = 0 := by simpa [hk0] using huu
    by_cases hdelta0 : delta = 0
    · let y : V K := e + p + u
      have hyy : c.mul y y = e + (2 : K) • p := by
        calc
          c.mul y y = c.mul (e + p + u) (e + p + u) := by rfl
          _ = c.mul (e + p) (e + p) + c.mul (e + p) u +
                c.mul u (e + p) + c.mul u u :=
            mul_add_add_three c (e + p) u (e + p) u
          _ = e + (2 : K) • p := by
            rw [show c.mul (e + p) (e + p) =
                c.mul e e + c.mul e p + c.mul p e + c.mul p p by
              simpa using mul_add_add_three c e p e p,
              show c.mul (e + p) u = c.mul e u + c.mul p u by
                change (mulLinear c (e + p)) u = _
                rw [(mulLinear c).map_add, LinearMap.add_apply,
                  mulLinear_apply, mulLinear_apply],
              show c.mul u (e + p) = c.mul u e + c.mul u p by
                change (mulLinear c u) (e + p) = _
                rw [map_add, mulLinear_apply, mulLinear_apply],
              hee, hep, hpe, hpp, heu, hpu, hue, hup, huu0, hdelta0]
            apply funext_three <;> simp [smul_add] <;> ring
      have hyyy : c.mul (c.mul y y) y = e + (3 : K) • p := by
        rw [hyy]
        calc
          c.mul (e + (2 : K) • p) y =
              c.mul (e + (2 : K) • p) (e + p + u) := by rfl
          _ = c.mul (e + (2 : K) • p) (e + p) +
                c.mul (e + (2 : K) • p) u := by
            change (mulLinear c (e + (2 : K) • p)) ((e + p) + u) = _
            rw [map_add, mulLinear_apply, mulLinear_apply]
          _ = e + (3 : K) • p := by
            rw [show c.mul (e + (2 : K) • p) (e + p) =
                c.mul e e + c.mul e p +
                  (2 : K) • c.mul p e + (2 : K) • c.mul p p by
              simpa only [one_smul, one_mul, mul_one] using
                mul_linearCombination_pair_three c e p 1 2 1 1,
              show c.mul (e + (2 : K) • p) u =
                  c.mul e u + (2 : K) • c.mul p u by
                change (mulLinear c (e + (2 : K) • p)) u = _
                rw [(mulLinear c).map_add, (mulLinear c).map_smul,
                  LinearMap.add_apply, LinearMap.smul_apply,
                  mulLinear_apply, mulLinear_apply],
              hee, hep, hpe, hpp, heu, hpu, hdelta0]
            apply funext_three <;> simp [smul_add, smul_smul] <;> ring
      have hplane : TripleIndependent
          (e + (2 : K) • p) (e + (3 : K) • p) u := by
        simpa only [one_smul] using
          tripleIndependent_plane_change hlin 1 2 1 3 (by norm_num)
      have hbase : TripleIndependent u
          (e + (2 : K) • p) (e + (3 : K) • p) :=
        tripleIndependent_cycle (tripleIndependent_cycle hplane)
      have hybasis : TripleIndependent y
          (e + (2 : K) • p) (e + (3 : K) • p) := by
        have hadd := tripleIndependent_add_span_to_first hbase 2 (-1)
        have hfirst : y = u +
            ((2 : K) • (e + (2 : K) • p) +
              (-1 : K) • (e + (3 : K) • p)) := by
          dsimp [y]
          module
        rw [hfirst]
        exact hadd
      refine ⟨y, ?_⟩
      rw [hyyy, hyy]
      exact hybasis
    · let y : V K := p + u
      have hyy : c.mul y y = delta • e := by
        calc
          c.mul y y = c.mul ((1 : K) • p + (1 : K) • u)
              ((1 : K) • p + (1 : K) • u) := by simp [y]
          _ = ((1 : K) * 1) • c.mul p p +
                ((1 : K) * 1) • c.mul p u +
                  ((1 : K) * 1) • c.mul u p +
                    ((1 : K) * 1) • c.mul u u :=
            mul_linearCombination_pair_three c p u 1 1 1 1
          _ = delta • e := by rw [hpp, hpu, hup, huu0]; simp
      have hyyy : c.mul (c.mul y y) y = delta • p := by
        rw [hyy]
        calc
          c.mul (delta • e) y =
              delta • c.mul e p + delta • c.mul e u := by
            rw [show y = p + u by rfl]
            rw [show c.mul (delta • e) (p + u) =
                c.mul (delta • e) p + c.mul (delta • e) u by
              change (mulLinear c (delta • e)) (p + u) = _
              rw [map_add, mulLinear_apply, mulLinear_apply],
              show c.mul (delta • e) p = delta • c.mul e p by
                simpa using mul_smul_smul_three c delta 1 e p,
              show c.mul (delta • e) u = delta • c.mul e u by
                simpa using mul_smul_smul_three c delta 1 e u]
          _ = delta • p := by rw [hep, heu]; simp
      have hdet : delta * delta - 0 * 0 ≠ 0 := by
        simpa using mul_ne_zero hdelta0 hdelta0
      have hplane : TripleIndependent (delta • e) (delta • p) u := by
        simpa using tripleIndependent_plane_change hlin delta 0 0 delta hdet
      have hbase : TripleIndependent u (delta • e) (delta • p) :=
        tripleIndependent_cycle (tripleIndependent_cycle hplane)
      have hybasis : TripleIndependent y (delta • e) (delta • p) := by
        have hadd := tripleIndependent_add_span_to_first
          hbase 0 delta⁻¹
        simpa [y, smul_smul, hdelta0, add_comm] using hadd
      refine ⟨y, ?_⟩
      rw [hyyy, hyy]
      exact hybasis
  · left
    let one : V K := e + k⁻¹ • u
    have honee : c.mul one e = e ∧ c.mul e one = e := by
      constructor
      · calc
          c.mul one e = c.mul (e + k⁻¹ • u) e := by rfl
          _ = c.mul e e + k⁻¹ • c.mul u e := by
            change (mulLinear c (e + k⁻¹ • u)) e = _
            rw [(mulLinear c).map_add, (mulLinear c).map_smul,
              LinearMap.add_apply, LinearMap.smul_apply,
              mulLinear_apply, mulLinear_apply]
          _ = e := by rw [hee, hue]; simp
      · calc
          c.mul e one = c.mul e (e + k⁻¹ • u) := by rfl
          _ = c.mul e e + k⁻¹ • c.mul e u := by
            change (mulLinear c e) (e + k⁻¹ • u) = _
            rw [map_add, map_smul, mulLinear_apply, mulLinear_apply]
          _ = e := by rw [hee, heu]; simp
    have honep : c.mul one p = p ∧ c.mul p one = p := by
      constructor
      · calc
          c.mul one p = c.mul (e + k⁻¹ • u) p := by rfl
          _ = c.mul e p + k⁻¹ • c.mul u p := by
            change (mulLinear c (e + k⁻¹ • u)) p = _
            rw [(mulLinear c).map_add, (mulLinear c).map_smul,
              LinearMap.add_apply, LinearMap.smul_apply,
              mulLinear_apply, mulLinear_apply]
          _ = p := by rw [hep, hup]; simp
      · calc
          c.mul p one = c.mul p (e + k⁻¹ • u) := by rfl
          _ = c.mul p e + k⁻¹ • c.mul p u := by
            change (mulLinear c p) (e + k⁻¹ • u) = _
            rw [map_add, map_smul, mulLinear_apply, mulLinear_apply]
          _ = p := by rw [hpe, hpu]; simp
    have honeu : c.mul one u = u ∧ c.mul u one = u := by
      constructor
      · calc
          c.mul one u = c.mul (e + k⁻¹ • u) u := by rfl
          _ = c.mul e u + k⁻¹ • c.mul u u := by
            change (mulLinear c (e + k⁻¹ • u)) u = _
            rw [(mulLinear c).map_add, (mulLinear c).map_smul,
              LinearMap.add_apply, LinearMap.smul_apply,
              mulLinear_apply, mulLinear_apply]
          _ = u := by rw [heu, huu]; simp [smul_smul, hk0]
      · calc
          c.mul u one = c.mul u (e + k⁻¹ • u) := by rfl
          _ = c.mul u e + k⁻¹ • c.mul u u := by
            change (mulLinear c u) (e + k⁻¹ • u) = _
            rw [map_add, map_smul, mulLinear_apply, mulLinear_apply]
          _ = u := by rw [hue, huu]; simp [smul_smul, hk0]
    exact hasTwoSidedIdentity_of_basis hlin honee honep honeu

/-- Complete reduction of a quadratic generated plane inside the waved
sector. -/
theorem nonunital_nonstraight_quadraticPair_classification [CharZero K]
    {c : StructureConstants K 3} (ha : c.MultiplicationAssociative)
    (hnonunit : ¬ HasTwoSidedIdentity c)
    (hnotstraight : ¬ IsStraight c)
    {delta : K} {e p g : V K} (hlin : TripleIndependent e p g)
    (hquad : IsQuadraticPair c delta e p) :
    Isomorphic c (fixedTable .w4) ∨
      Isomorphic c (fixedTable .w5) ∨
      Isomorphic c (fixedTable .w6) ∨
      Isomorphic c (fixedTable .w7) ∨
      Isomorphic c (fixedTable .w8) ∨
      Isomorphic c (fixedTable .w9) ∨
      Isomorphic c (fixedTable .w10) := by
  obtain ⟨u, hlinu, h00 | h01 | h10 | h11⟩ :=
    exists_peirce_basis_of_quadraticPair ha hlin hquad
  · rcases quadratic_peirce00_unital_or_straight
      ha hlinu hquad h00.1 h00.2 with hu | hs
    · exact False.elim (hnonunit hu)
    · exact False.elim (hnotstraight hs)
  · rcases quadratic_peirce01_classification
      ha hnotstraight hlinu hquad h01.1 h01.2 with
      (h4 | h5 | h6 | h7 | h8) | h9
    · exact Or.inl h4
    · exact Or.inr (Or.inl h5)
    · exact Or.inr (Or.inr (Or.inl h6))
    · exact Or.inr (Or.inr (Or.inr (Or.inl h7)))
    · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h8))))
    · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h9)))))
  · rcases quadratic_peirce10_classification
      ha hnotstraight hlinu hquad h10.1 h10.2 with
      (h4 | h5 | h6 | h7 | h8) | h10'
    · exact Or.inl h4
    · exact Or.inr (Or.inl h5)
    · exact Or.inr (Or.inr (Or.inl h6))
    · exact Or.inr (Or.inr (Or.inr (Or.inl h7)))
    · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h8))))
    · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr h10')))))
  · rcases hquad with ⟨hee, hep, hpe, _hpp⟩
    have hid : HasTwoSidedIdentity c :=
      hasTwoSidedIdentity_of_basis hlinu ⟨hee, hee⟩ ⟨hep, hpe⟩ h11
    exact False.elim (hnonunit hid)

/-- Normalize a monogenic plane satisfying `f³ = a f + b f²`.

There are three intrinsic outcomes: a nilpotent chain, an idempotent with an
annihilating complement, or a unital quadratic plane.  The last parameter is
`a+b²/4`; its square class will later distinguish the complex and real cases.
-/
theorem normalize_generator_plane [CharZero K]
    {c : StructureConstants K 3} {f f2 g : V K} {a b : K}
    (hlin : TripleIndependent f f2 g)
    (hff : c.mul f f = f2)
    (hff2 : c.mul f f2 = a • f + b • f2)
    (hf2f : c.mul f2 f = a • f + b • f2)
    (hf2f2 : c.mul f2 f2 =
      (a * b) • f + (a + b * b) • f2) :
    ∃ e p : V K, TripleIndependent e p g ∧
      (IsNilpotentChainPair c e p ∨
        IsIdempotentAnnihilatorPair c e p ∨
        ∃ delta : K, IsQuadraticPair c delta e p) := by
  by_cases ha : a = 0
  · subst a
    by_cases hb : b = 0
    · subst b
      refine ⟨f2, f, tripleIndependent_swap_first hlin, Or.inl ?_⟩
      simp only [IsNilpotentChainPair]
      exact ⟨by simpa using hf2f2, by simpa using hf2f,
        by simpa using hff2, hff⟩
    · let s : K := b⁻¹
      let e : V K := (s * s) • f2
      let p : V K := s • f - (s * s) • f2
      have hs : s ≠ 0 := inv_ne_zero hb
      have hdet :
          (0 : K) * (-(s * s)) - (s * s) * s ≠ 0 := by
        simp only [MulZeroClass.zero_mul, zero_sub]
        exact neg_ne_zero.mpr (mul_ne_zero (mul_ne_zero hs hs) hs)
      have hlin' : TripleIndependent e p g := by
        simpa [e, p, sub_eq_add_neg] using
          tripleIndependent_plane_change hlin 0 (s * s) s (-(s * s)) hdet
      have hee : c.mul e e = e := by
        calc
          c.mul e e = ((s * s) * (s * s)) • c.mul f2 f2 := by
            exact mul_smul_smul_three c (s * s) (s * s) f2 f2
          _ = e := by
            rw [hf2f2]
            apply funext_three <;> simp [e, s, smul_add, smul_smul] <;>
              field_simp [hb] <;> ring
      have hep : c.mul e p = 0 := by
        rw [show e = (0 : K) • f + (s * s) • f2 by simp [e],
          show p = s • f + (-(s * s)) • f2 by
            simp [p, sub_eq_add_neg]]
        rw [mul_linearCombination_pair_three, hff, hff2, hf2f, hf2f2]
        apply funext_three <;> simp [s, smul_add, smul_smul] <;>
          field_simp [hb] <;> ring
      have hpe : c.mul p e = 0 := by
        rw [show p = s • f + (-(s * s)) • f2 by
              simp [p, sub_eq_add_neg],
          show e = (0 : K) • f + (s * s) • f2 by simp [e]]
        rw [mul_linearCombination_pair_three, hff, hff2, hf2f, hf2f2]
        apply funext_three <;> simp [s, smul_add, smul_smul] <;>
          field_simp [hb] <;> ring
      have hpp : c.mul p p = 0 := by
        rw [show p = s • f + (-(s * s)) • f2 by
          simp [p, sub_eq_add_neg]]
        rw [mul_linearCombination_pair_three, hff, hff2, hf2f, hf2f2]
        apply funext_three <;> simp [s, smul_add, smul_smul] <;>
          field_simp [hb] <;> ring
      exact ⟨e, p, hlin', Or.inr (Or.inl ⟨hee, hep, hpe, hpp⟩)⟩
  · let s : K := a⁻¹
    let e : V K := (-b * s) • f + s • f2
    let t : K := b / 2
    let p : V K := f - t • e
    let delta : K := a + b * b / 4
    have hs : s ≠ 0 := inv_ne_zero ha
    have hea : s * a = 1 := inv_mul_cancel₀ ha
    have heF : c.mul e f = f := by
      rw [show e = (-b * s) • f + s • f2 by rfl]
      change (mulLinear c ((-b * s) • f + s • f2)) f = f
      rw [(mulLinear c).map_add, (mulLinear c).map_smul,
        (mulLinear c).map_smul, LinearMap.add_apply,
        LinearMap.smul_apply, LinearMap.smul_apply, mulLinear_apply,
        mulLinear_apply, hff, hf2f]
      apply funext_three <;> simp [smul_add, smul_smul, s] <;>
        field_simp [ha] <;> ring
    have hFe : c.mul f e = f := by
      rw [show e = (-b * s) • f + s • f2 by rfl]
      change (mulLinear c f) ((-b * s) • f + s • f2) = f
      rw [map_add, map_smul, map_smul, mulLinear_apply, mulLinear_apply,
        hff, hff2]
      apply funext_three <;> simp [smul_add, smul_smul, s] <;>
        field_simp [ha] <;> ring
    have heF2 : c.mul e f2 = f2 := by
      rw [show e = (-b * s) • f + s • f2 by rfl]
      change (mulLinear c ((-b * s) • f + s • f2)) f2 = f2
      rw [(mulLinear c).map_add, (mulLinear c).map_smul,
        (mulLinear c).map_smul, LinearMap.add_apply,
        LinearMap.smul_apply, LinearMap.smul_apply, mulLinear_apply,
        mulLinear_apply, hff2, hf2f2]
      apply funext_three <;> simp [smul_add, smul_smul, s] <;>
        field_simp [ha] <;> ring
    have hF2e : c.mul f2 e = f2 := by
      rw [show e = (-b * s) • f + s • f2 by rfl]
      change (mulLinear c f2) ((-b * s) • f + s • f2) = f2
      rw [map_add, map_smul, map_smul, mulLinear_apply, mulLinear_apply,
        hf2f, hf2f2]
      apply funext_three <;> simp [smul_add, smul_smul, s] <;>
        field_simp [ha] <;> ring
    have hee : c.mul e e = e := by
      calc
        c.mul e e = c.mul e ((-b * s) • f + s • f2) := by rfl
        _ = (-b * s) • c.mul e f + s • c.mul e f2 := by
          change (mulLinear c e) ((-b * s) • f + s • f2) = _
          rw [map_add, map_smul, map_smul, mulLinear_apply, mulLinear_apply]
        _ = e := by rw [heF, heF2]
    have hf2rep : f2 = a • e + b • f := by
      rw [show e = (-b * s) • f + s • f2 by rfl]
      apply funext_three <;> simp [smul_add, smul_smul, s] <;>
        field_simp [ha] <;> ring
    have hep : c.mul e p = p := by
      calc
        c.mul e p = c.mul e (f - t • e) := by rfl
        _ = c.mul e f - t • c.mul e e := by
          change (mulLinear c e) (f - t • e) = _
          rw [map_sub, map_smul, mulLinear_apply, mulLinear_apply]
        _ = p := by rw [heF, hee]
    have hpe : c.mul p e = p := by
      calc
        c.mul p e = c.mul (f - t • e) e := by rfl
        _ = c.mul f e - t • c.mul e e := by
          change (mulLinear c (f - t • e)) e = _
          rw [(mulLinear c).map_sub, (mulLinear c).map_smul,
            LinearMap.sub_apply, LinearMap.smul_apply, mulLinear_apply,
            mulLinear_apply]
        _ = p := by rw [hFe, hee]
    have hpp : c.mul p p = delta • e := by
      calc
        c.mul p p = c.mul (f - t • e) (f - t • e) := by rfl
        _ = ((1 : K) * 1) • c.mul f f +
              ((1 : K) * (-t)) • c.mul f e +
                ((-t) * 1) • c.mul e f +
                  ((-t) * (-t)) • c.mul e e := by
          simpa only [one_smul, neg_smul, sub_eq_add_neg] using
            mul_linearCombination_pair_three c f e 1 (-t) 1 (-t)
        _ = delta • e := by
          rw [hff, hFe, heF, hee, hf2rep]
          apply funext_three <;>
            simp [delta, t, smul_add, smul_smul] <;> field_simp <;> ring
    have hdet :
        (-b * s) * (-(b * s / 2)) -
            s * (1 + b * b * s / 2) ≠ 0 := by
      have heq :
          (-b * s) * (-(b * s / 2)) -
              s * (1 + b * b * s / 2) = -s := by ring
      rw [heq]
      exact neg_ne_zero.mpr hs
    have hlin' : TripleIndependent e p g := by
      have hchange := tripleIndependent_plane_change hlin
        (-b * s) s (1 + b * b * s / 2) (-(b * s / 2)) hdet
      have hpRep : p =
          (1 + b * b * s / 2) • f + (-(b * s / 2)) • f2 := by
        rw [show p = f - t • e by rfl, show e = (-b * s) • f + s • f2 by rfl]
        apply funext_three <;>
          simp [t, sub_eq_add_neg, smul_add, smul_smul] <;> ring
      rw [hpRep]
      exact hchange
    exact ⟨e, p, hlin', Or.inr (Or.inr ⟨delta, hee, hep, hpe, hpp⟩)⟩

/-- The multiplication inherited by the generated plane, stated entirely in
the ambient three-dimensional space. -/
theorem waved_generator_plane_relations
    {c : StructureConstants K 3} (ha : c.MultiplicationAssociative)
    (hw : IsWaved c) :
    ∃ f f2 g : V K, ∃ a b : K,
      TripleIndependent f f2 g ∧
      c.mul f f = f2 ∧
      c.mul f f2 = a • f + b • f2 ∧
      c.mul f2 f = a • f + b • f2 ∧
      c.mul f2 f2 = (a * b) • f + (a + b * b) • f2 := by
  obtain ⟨f, g, a, b, hbasis, hcubic⟩ := exists_waved_generator_basis hw
  let f2 := c.mul f f
  refine ⟨f, f2, g, a, b, ?_, rfl, ?_, ?_, ?_⟩
  · simpa [f2] using hbasis
  · simpa [f2] using
      (show c.mul f (c.mul f f) = a • f + b • c.mul f f from
        (cube_commutes_of_associative ha f).trans hcubic)
  · simpa [f2] using hcubic
  · simpa [f2] using fourth_power_of_cubic_relation ha hcubic

/-- Every associative waved table contains one of the three normalized
two-dimensional planes above, and the displayed pair extends to a basis of the
ambient algebra. -/
theorem waved_has_normalized_generator_plane [CharZero K]
    {c : StructureConstants K 3} (ha : c.MultiplicationAssociative)
    (hw : IsWaved c) :
    ∃ e p g : V K, TripleIndependent e p g ∧
      (IsNilpotentChainPair c e p ∨
        IsIdempotentAnnihilatorPair c e p ∨
        ∃ delta : K, IsQuadraticPair c delta e p) := by
  obtain ⟨f, f2, g, a, b, hlin, hff, hff2, hf2f, hf2f2⟩ :=
    waved_generator_plane_relations ha hw
  obtain ⟨e, p, hlin', hnormal⟩ :=
    normalize_generator_plane hlin hff hff2 hf2f hf2f2
  exact ⟨e, p, g, hlin', hnormal⟩

/-! ## Waved-sector and global coverage -/

/-- Every associative complex table in the waved sector belongs to the
audited complex candidate list. -/
theorem complex_waved_sector_coverage
    {c : StructureConstants ℂ 3} (ha : c.MultiplicationAssociative)
    (hsector : InSector c .waved) : CoveredByComplexCandidates c := by
  rcases hsector with ⟨hnonunit, hw⟩
  obtain ⟨e, p, g, hlin, hnil | hidem | ⟨delta, hquad⟩⟩ :=
    waved_has_normalized_generator_plane ha hw
  · rcases complex_waved_nilpotentChain_classification
      c ha hnonunit hw.2 hlin hnil with h1 | h2 | ⟨k, hk⟩
    · exact ⟨.fixed .w1, by simpa [complexCandidateTable] using h1⟩
    · exact ⟨.fixed .w2, by simpa [complexCandidateTable] using h2⟩
    · exact ⟨.waved k, by simpa [complexCandidateTable] using hk⟩
  · rcases nonstraight_idempotentAnnihilator_classification
      ha hw.2 hlin hidem with h4 | h5 | h6 | h7 | h8
    · exact ⟨.fixed .w4, by simpa [complexCandidateTable] using h4⟩
    · exact ⟨.fixed .w5, by simpa [complexCandidateTable] using h5⟩
    · exact ⟨.fixed .w6, by simpa [complexCandidateTable] using h6⟩
    · exact ⟨.fixed .w7, by simpa [complexCandidateTable] using h7⟩
    · exact ⟨.fixed .w8, by simpa [complexCandidateTable] using h8⟩
  · rcases nonunital_nonstraight_quadraticPair_classification
      ha hnonunit hw.2 hlin hquad with h4 | h5 | h6 | h7 | h8 | h9 | h10
    · exact ⟨.fixed .w4, by simpa [complexCandidateTable] using h4⟩
    · exact ⟨.fixed .w5, by simpa [complexCandidateTable] using h5⟩
    · exact ⟨.fixed .w6, by simpa [complexCandidateTable] using h6⟩
    · exact ⟨.fixed .w7, by simpa [complexCandidateTable] using h7⟩
    · exact ⟨.fixed .w8, by simpa [complexCandidateTable] using h8⟩
    · exact ⟨.fixed .w9, by simpa [complexCandidateTable] using h9⟩
    · exact ⟨.fixed .w10, by simpa [complexCandidateTable] using h10⟩

/-- Every associative real table in the waved sector belongs to the audited
real candidate list. -/
theorem real_waved_sector_coverage
    {c : StructureConstants ℝ 3} (ha : c.MultiplicationAssociative)
    (hsector : InSector c .waved) : CoveredByRealCandidates c := by
  rcases hsector with ⟨hnonunit, hw⟩
  obtain ⟨e, p, g, hlin, hnil | hidem | ⟨delta, hquad⟩⟩ :=
    waved_has_normalized_generator_plane ha hw
  · rcases real_waved_nilpotentChain_classification
      c ha hnonunit hw.2 hlin hnil with h1 | h2 | hp | hm
    · exact ⟨.fixed .w1, by simpa [realCandidateTable] using h1⟩
    · exact ⟨.fixed .w2, by simpa [realCandidateTable] using h2⟩
    · obtain ⟨k, hk⟩ := hp
      exact ⟨.waved k, by simpa [realCandidateTable] using hk⟩
    · obtain ⟨k, hk⟩ := hm
      exact ⟨.wavedMinus k, by simpa [realCandidateTable] using hk⟩
  · rcases nonstraight_idempotentAnnihilator_classification
      ha hw.2 hlin hidem with h4 | h5 | h6 | h7 | h8
    · exact ⟨.fixed .w4, by simpa [realCandidateTable] using h4⟩
    · exact ⟨.fixed .w5, by simpa [realCandidateTable] using h5⟩
    · exact ⟨.fixed .w6, by simpa [realCandidateTable] using h6⟩
    · exact ⟨.fixed .w7, by simpa [realCandidateTable] using h7⟩
    · exact ⟨.fixed .w8, by simpa [realCandidateTable] using h8⟩
  · rcases nonunital_nonstraight_quadraticPair_classification
      ha hnonunit hw.2 hlin hquad with h4 | h5 | h6 | h7 | h8 | h9 | h10
    · exact ⟨.fixed .w4, by simpa [realCandidateTable] using h4⟩
    · exact ⟨.fixed .w5, by simpa [realCandidateTable] using h5⟩
    · exact ⟨.fixed .w6, by simpa [realCandidateTable] using h6⟩
    · exact ⟨.fixed .w7, by simpa [realCandidateTable] using h7⟩
    · exact ⟨.fixed .w8, by simpa [realCandidateTable] using h8⟩
    · exact ⟨.fixed .w9, by simpa [realCandidateTable] using h9⟩
    · exact ⟨.fixed .w10, by simpa [realCandidateTable] using h10⟩

/-- Exhaustive candidate coverage for associative complex algebras of
dimension three. -/
theorem complex_dimensionThree_coverage
    (c : StructureConstants ℂ 3) (ha : c.MultiplicationAssociative) :
    CoveredByComplexCandidates c := by
  apply complex_coverage_of_sector_coverage
  intro sector d hd hsector
  cases sector with
  | unital => exact complex_unital_sector_coverage hd hsector
  | curled => exact complex_curled_sector_coverage d hd hsector
  | waved => exact complex_waved_sector_coverage hd hsector
  | straight => exact complex_straight_sector_coverage d hd hsector
  exact ha

/-- Exhaustive candidate coverage for associative real algebras of dimension
three. -/
theorem real_dimensionThree_coverage
    (c : StructureConstants ℝ 3) (ha : c.MultiplicationAssociative) :
    CoveredByRealCandidates c := by
  apply real_coverage_of_sector_coverage
  intro sector d hd hsector
  cases sector with
  | unital => exact real_unital_sector_coverage hd hsector
  | curled => exact real_curled_sector_coverage d hd hsector
  | waved => exact real_waved_sector_coverage hd hsector
  | straight => exact real_straight_sector_coverage d hd hsector
  exact ha

/-! ## Associativity and exact isomorphism-class quotients -/

theorem complexCandidateTable_multiplicationAssociative
    (a : ComplexCandidate) :
    (complexCandidateTable a).MultiplicationAssociative := by
  cases a with
  | fixed f =>
      simpa [complexCandidateTable] using
        fixedTable_multiplicationAssociative (K := ℂ) f
  | waved k =>
      simpa [complexCandidateTable] using
        wavedTable_multiplicationAssociative k

theorem realCandidateTable_multiplicationAssociative
    (a : RealCandidate) :
    (realCandidateTable a).MultiplicationAssociative := by
  cases a with
  | fixed f =>
      simpa [realCandidateTable] using
        fixedTable_multiplicationAssociative (K := ℝ) f
  | unitalMinus =>
      simpa [realCandidateTable] using
        (realUnitalMinusTable_multiplicationAssociative (K := ℝ))
  | straightMinus =>
      simpa [realCandidateTable] using
        (realStraightMinusTable_multiplicationAssociative (K := ℝ))
  | waved k =>
      simpa [realCandidateTable] using
        wavedTable_multiplicationAssociative k
  | wavedMinus k =>
      simpa [realCandidateTable] using
        realWavedMinusTable_multiplicationAssociative k

/-- The proven candidate equivalence is an actual equivalence relation because
it is exactly table isomorphism. -/
def complexCandidateSetoid : Setoid ComplexCandidate where
  r := ComplexCandidate.Equivalent
  iseqv := ⟨
    fun a => (complexCandidateTable_isomorphic_iff a a).mp
      (Isomorphic.refl (complexCandidateTable a)),
    fun {a b} hab => (complexCandidateTable_isomorphic_iff b a).mp
      (Isomorphic.symm ((complexCandidateTable_isomorphic_iff a b).mpr hab)),
    fun {a b d} hab hbd => (complexCandidateTable_isomorphic_iff a d).mp
      (Isomorphic.trans ((complexCandidateTable_isomorphic_iff a b).mpr hab)
        ((complexCandidateTable_isomorphic_iff b d).mpr hbd))⟩

def realCandidateSetoid : Setoid RealCandidate where
  r := RealCandidate.Equivalent
  iseqv := ⟨
    fun a => (realCandidateTable_isomorphic_iff a a).mp
      (Isomorphic.refl (realCandidateTable a)),
    fun {a b} hab => (realCandidateTable_isomorphic_iff b a).mp
      (Isomorphic.symm ((realCandidateTable_isomorphic_iff a b).mpr hab)),
    fun {a b d} hab hbd => (realCandidateTable_isomorphic_iff a d).mp
      (Isomorphic.trans ((realCandidateTable_isomorphic_iff a b).mpr hab)
        ((realCandidateTable_isomorphic_iff b d).mpr hbd))⟩

abbrev ComplexDimensionThreeClass := Quotient complexCandidateSetoid
abbrev RealDimensionThreeClass := Quotient realCandidateSetoid

/-- Exhaustiveness plus exact uniqueness for complex dimension-three tables.
The quantified `iff` includes the proven `k ~ -k` identification. -/
theorem complex_dimensionThree_classification
    (c : StructureConstants ℂ 3) (ha : c.MultiplicationAssociative) :
    ∃ a : ComplexCandidate,
      Isomorphic c (complexCandidateTable a) ∧
      ∀ b : ComplexCandidate,
        Isomorphic c (complexCandidateTable b) ↔ a.Equivalent b := by
  obtain ⟨a, hca⟩ := complex_dimensionThree_coverage c ha
  refine ⟨a, hca, ?_⟩
  intro b
  constructor
  · intro hcb
    exact (complexCandidateTable_isomorphic_iff a b).mp
      (Isomorphic.trans (Isomorphic.symm hca) hcb)
  · intro hab
    exact Isomorphic.trans hca
      ((complexCandidateTable_isomorphic_iff a b).mpr hab)

/-- Exhaustiveness plus exact uniqueness for real dimension-three tables. -/
theorem real_dimensionThree_classification
    (c : StructureConstants ℝ 3) (ha : c.MultiplicationAssociative) :
    ∃ a : RealCandidate,
      Isomorphic c (realCandidateTable a) ∧
      ∀ b : RealCandidate,
        Isomorphic c (realCandidateTable b) ↔ a.Equivalent b := by
  obtain ⟨a, hca⟩ := real_dimensionThree_coverage c ha
  refine ⟨a, hca, ?_⟩
  intro b
  constructor
  · intro hcb
    exact (realCandidateTable_isomorphic_iff a b).mp
      (Isomorphic.trans (Isomorphic.symm hca) hcb)
  · intro hab
    exact Isomorphic.trans hca
      ((realCandidateTable_isomorphic_iff a b).mpr hab)

/-- Every associative complex table determines one and only one element of
the candidate quotient. -/
theorem complex_dimensionThree_quotient_classification
    (c : StructureConstants ℂ 3) (ha : c.MultiplicationAssociative) :
    ∃! q : ComplexDimensionThreeClass,
      ∃ a : ComplexCandidate,
        Quotient.mk complexCandidateSetoid a = q ∧
          Isomorphic c (complexCandidateTable a) := by
  obtain ⟨a, hca⟩ := complex_dimensionThree_coverage c ha
  refine ⟨Quotient.mk complexCandidateSetoid a, ⟨a, rfl, hca⟩, ?_⟩
  intro q hq
  obtain ⟨b, hbq, hcb⟩ := hq
  have hab : a.Equivalent b :=
    (complexCandidateTable_isomorphic_iff a b).mp
      (Isomorphic.trans (Isomorphic.symm hca) hcb)
  calc
    q = Quotient.mk complexCandidateSetoid b := hbq.symm
    _ = Quotient.mk complexCandidateSetoid a := (Quotient.sound hab).symm

/-- Every associative real table determines one and only one element of the
candidate quotient. -/
theorem real_dimensionThree_quotient_classification
    (c : StructureConstants ℝ 3) (ha : c.MultiplicationAssociative) :
    ∃! q : RealDimensionThreeClass,
      ∃ a : RealCandidate,
        Quotient.mk realCandidateSetoid a = q ∧
          Isomorphic c (realCandidateTable a) := by
  obtain ⟨a, hca⟩ := real_dimensionThree_coverage c ha
  refine ⟨Quotient.mk realCandidateSetoid a, ⟨a, rfl, hca⟩, ?_⟩
  intro q hq
  obtain ⟨b, hbq, hcb⟩ := hq
  have hab : a.Equivalent b :=
    (realCandidateTable_isomorphic_iff a b).mp
      (Isomorphic.trans (Isomorphic.symm hca) hcb)
  calc
    q = Quotient.mk realCandidateSetoid b := hbq.symm
    _ = Quotient.mk realCandidateSetoid a := (Quotient.sound hab).symm

end CodexAIGC.DimensionThreeRealComplex
